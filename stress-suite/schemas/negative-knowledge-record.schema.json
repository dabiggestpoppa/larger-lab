{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dabiggestpoppa/larger-lab/schema/stress-suite/negative-knowledge-record.json",
  "title": "OCE Stress Suite NegativeKnowledgeRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id","schema_version","claim_rejected","exact_scope","rejection_reason","current_lifecycle_state"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string"},
    "claim_rejected": {"type": "string"},
    "exact_scope": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "rejection_reason": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "reopen_conditions": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": ["object", "null"]},
    "author_actor": {"type": "string"},
    "authority_basis": {"type": "string"},
    "current_lifecycle_state": {"type": "string"},
    "seq": {"type": "integer", "minimum": 0},
    "permanent_by_operator_authority": {"type": ["string","null"]},
    "permanence_authority": {
      "description": "G4-P0-C/G4R-08 attributable authority block: actor, actual AuthorityState level, authority basis, ratification reference, binding kind. REQUIRED whenever permanent_by_operator_authority is non-null; schema and Python validation agree (G4R-09)",
      "type": ["object","null"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "actual_level": {"type": "string", "enum": ["OPERATOR"]},
        "authority_basis": {"type": "string", "minLength": 1},
        "ratification_ref": {"type": "string", "minLength": 1},
        "binding": {"type": "string", "enum": ["EXACT_AUTHORITY_STATE"]}
      },
      "required": ["actor","actual_level","authority_basis","ratification_ref","binding"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"permanent_by_operator_authority": {"type": "string", "minLength": 1}}, "required": ["permanent_by_operator_authority"]},
      "then": {"required": ["permanence_authority"]}
    }
  ]
}