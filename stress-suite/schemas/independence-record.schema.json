{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dabiggestpoppa/larger-lab/schema/stress-suite/independence-record.json",
  "title": "OCE Stress Suite IndependenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id","schema_version","raw_reviewers","seq"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string"},
    "raw_reviewers": {"type": "integer", "minimum": 0},
    "distinct_source_lineages": {"type": "integer", "minimum": 0},
    "distinct_model_families": {"type": "integer", "minimum": 0},
    "distinct_retrieval_bundles": {"type": "integer", "minimum": 0},
    "overlaps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_family_overlap","provider_overlap","source_overlap","retrieval_overlap","prompt_context_overlap","prior_conclusion_exposure","implementation_path_overlap","experiment_design_overlap","runtime_lineage_overlap_if_known","allocator_overlap"],
      "patternProperties": {"^[a-z_]+$": {"enum": ["NONE","LOW","MEDIUM","HIGH","UNKNOWN"]}}
    },
    "reviewers": {"type": "array", "items": {"type": "object"}},
    "seq": {"type": "integer", "minimum": 0}
  }
}