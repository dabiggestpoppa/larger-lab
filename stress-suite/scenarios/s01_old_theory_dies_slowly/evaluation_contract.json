{
  "contract_id": "S01-EVAL-V1",
  "schema_version": "1.0.0",
  "version_tag": "V1",
  "authority_basis": "PROVISIONAL_SCENARIO_TEST_POLICY (G2 §4)",
  "channel_rules": {
    "reliability_degradation": {"threshold": "MEDIUM", "visibility_policy": "PUBLIC"},
    "exception_burden": {"threshold": "MEDIUM", "visibility_policy": "PUBLIC"},
    "independent_contradiction": {"threshold": "MEDIUM", "visibility_policy": "PUBLIC"},
    "unresolved_pattern_density": {"threshold": "LOW", "visibility_policy": "PUBLIC"},
    "dependency_centrality": {"threshold": "HIGH", "visibility_policy": "PUBLIC"},
    "external_environment_shift": {"threshold": "LOW", "visibility_policy": "PUBLIC"},
    "opportunity_cost_of_stability": {"threshold": "LOW", "visibility_policy": "PUBLIC"},
    "cost_and_reversibility": {"threshold": "MEDIUM", "visibility_policy": "PUBLIC"}
  },
  "hysteresis_rules": {
    "enter_watch": "any_of(>= MEDIUM) on reliability/exception/contradiction — inherited from contract",
    "escalation": "persistence(3) of independent_contradiction >= MEDIUM",
    "transformation_candidate": "persistence(3) + all_of(contra HIGH, reliability >= MEDIUM) + CORE stronger-review gate",
    "leave_review": "NOT the mechanical inverse of entry; recovery uses equality-to-LOW gates with all_of"
  },
  "admissible_phase_transitions": [
    ["STABLE", "WATCH"],
    ["WATCH", "ESCALATION_REVIEW"],
    ["ESCALATION_REVIEW", "TRANSFORMATION_CANDIDATE"],
    ["TRANSFORMATION_CANDIDATE", "TRANSFORMATION_WINDOW"],
    ["TRANSFORMATION_WINDOW", "RECONSOLIDATION"],
    ["RECONSOLIDATION", "NEW_STABLE"]
  ]
}