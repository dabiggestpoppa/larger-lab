{
  "policy_id": "S01W-POLICY",
  "version_tag": "V1",
  "status": "PROVISIONAL_SCENARIO_TEST_POLICY",
  "authority_basis": "identical rule set to S01 — the SENSITIVITY is in the stimulus, not the policy",
  "rules": [
    {"rule_id": "S01.enter.watch", "to_state": "WATCH",
     "any_of": [{"channel": "reliability_degradation"}, {"channel": "exception_burden"}, {"channel": "independent_contradiction"}, {"channel": "unresolved_pattern_density"}],
     "rationale": "any material tension opens WATCH"},
    {"rule_id": "S01.escalate.persist", "to_state": "ESCALATION_REVIEW",
     "all_of": [{"independent_contradiction": "MEDIUM"}],
     "persistence": {"channel": "independent_contradiction", "grade": "MEDIUM", "minimum_observations": 3},
     "rationale": "contradiction must persist"},
    {"rule_id": "S01.candidate.structural", "to_state": "TRANSFORMATION_CANDIDATE",
     "all_of": [{"independent_contradiction": "HIGH"}, {"reliability_degradation": "MEDIUM"}],
     "persistence": {"channel": "independent_contradiction", "grade": "MEDIUM", "minimum_observations": 3},
     "dependency": {"min_centrality": "HIGH", "requires_stronger_review": true},
     "rationale": "persistent structural contradiction on CORE surface"},
    {"rule_id": "S01.window.open", "to_state": "TRANSFORMATION_WINDOW",
     "all_of": [{"independent_contradiction": "HIGH"}],
     "persistence": {"channel": "independent_contradiction", "grade": "MEDIUM", "minimum_observations": 3},
     "rationale": "window opens after persistence"},
    {"rule_id": "S01.reconsolidate", "to_state": "RECONSOLIDATION",
     "all_of": [{"independent_contradiction": "HIGH"}, {"reliability_degradation": "HIGH"}],
     "persistence": {"channel": "independent_contradiction", "grade": "MEDIUM", "minimum_observations": 3},
     "rationale": "window completes"},
    {"rule_id": "S01.new.stable", "to_state": "NEW_STABLE",
     "all_of": [{"independent_contradiction": "LOW", "op": "eq"}, {"reliability_degradation": "LOW", "op": "eq"}, {"unresolved_pattern_density": "LOW", "op": "eq"}],
     "prior": {"channel": "independent_contradiction", "grade": "HIGH", "within": 5, "count": 2},
     "rationale": "resolution must follow a genuine structural episode; weak evidence never satisfies it"},
    {"rule_id": "S01.exit.watch", "to_state": "STABLE",
     "all_of": [{"independent_contradiction": "LOW", "op": "eq"}, {"reliability_degradation": "LOW", "op": "eq"}],
     "rationale": "recovery closes WATCH"}
  ]
}