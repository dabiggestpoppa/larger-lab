{
  "policy_id": "S05-POLICY",
  "version_tag": "V1",
  "status": "PROVISIONAL_SCENARIO_TEST_POLICY",
  "authority_basis": "G2 §13: non-domination is an honest epistemic outcome; no averaging, no forced winner; M4 knowledge plurality survives M5 phase return",
  "rules": [
    {"rule_id": "S05.enter.watch", "to_state": "WATCH",
     "any_of": [{"channel": "independent_contradiction"}],
     "rationale": "challenger contradiction opens WATCH"},
    {"rule_id": "S05.escalate.review", "to_state": "ESCALATION_REVIEW",
     "all_of": [{"independent_contradiction": "HIGH"}],
     "persistence": {"channel": "independent_contradiction", "grade": "HIGH", "minimum_observations": 2},
     "rationale": "sustained high-grade contradiction escalates"},
    {"rule_id": "S05.candidate.plural.issue", "to_state": "TRANSFORMATION_CANDIDATE",
     "all_of": [{"independent_contradiction": "HIGH"}, {"reliability_degradation": "MEDIUM"}],
     "persistence": {"channel": "independent_contradiction", "grade": "HIGH", "minimum_observations": 3},
     "rationale": "two models explain disjoint condition spaces: unresolved multiplicity, not a fault"},
    {"rule_id": "S05.window.open", "to_state": "TRANSFORMATION_WINDOW",
     "all_of": [{"independent_contradiction": "HIGH"}],
     "persistence": {"channel": "independent_contradiction", "grade": "HIGH", "minimum_observations": 2},
     "rationale": "transformation window opens to resolve the multiplicity"},
    {"rule_id": "S05.reconsolidate", "to_state": "RECONSOLIDATION",
     "all_of": [{"independent_contradiction": "HIGH"}, {"unresolved_pattern_density": "MEDIUM"}],
     "persistence": {"channel": "independent_contradiction", "grade": "HIGH", "minimum_observations": 2},
     "rationale": "window completes with multiplicity still unresolved"},
    {"rule_id": "S05.plural.model", "to_state": "PLURAL_MODEL_STATE",
     "all_of": [{"unresolved_pattern_density": "HIGH"}],
     "persistence": {"channel": "independent_contradiction", "grade": "HIGH", "minimum_observations": 2},
     "rationale": "no global dominance established: preserve both models' conditions, evidence, and next discriminating observations"},
    {"rule_id": "S05.stable.after.plural", "to_state": "STABLE",
     "all_of": [{"independent_contradiction": "LOW", "op": "eq"}, {"reliability_degradation": "LOW", "op": "eq"}],
     "rationale": "institutional phase may return to STABLE; M4 knowledge state must keep the unresolved multiplicity"}
  ]
}