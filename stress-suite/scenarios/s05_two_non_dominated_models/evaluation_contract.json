{
  "contract_id": "S05-EVAL-V1",
  "schema_version": "1.0.0",
  "version_tag": "V1",
  "authority_basis": "PROVISIONAL_SCENARIO_TEST_POLICY (G2 §4)",
  "channel_rules": {
    "reliability_degradation": {"threshold": "HIGH", "visibility_policy": "PUBLIC"},
    "exception_burden": {"threshold": "MEDIUM", "visibility_policy": "PUBLIC"},
    "independent_contradiction": {"threshold": "HIGH", "visibility_policy": "PUBLIC"},
    "unresolved_pattern_density": {"threshold": "MEDIUM", "visibility_policy": "PUBLIC"},
    "dependency_centrality": {"threshold": "HIGH", "visibility_policy": "PUBLIC"},
    "external_environment_shift": {"threshold": "LOW", "visibility_policy": "PUBLIC"},
    "opportunity_cost_of_stability": {"threshold": "LOW", "visibility_policy": "PUBLIC"},
    "cost_and_reversibility": {"threshold": "MEDIUM", "visibility_policy": "PUBLIC"}
  },
  "hysteresis_rules": {
    "enter_watch": "any_of(>= HIGH) on independent_contradiction (inherited)",
    "escalation": "persistence(2) of independent_contradiction >= HIGH",
    "candidate": "persistence(3) + reliability >= MEDIUM",
    "plural_outcome": "PLURAL_MODEL_STATE when unresolved_pattern_density HIGH + contradiction persists — never average, never force a winner"
  },
  "admissible_phase_transitions": [
    ["STABLE", "WATCH"],
    ["WATCH", "ESCALATION_REVIEW"],
    ["ESCALATION_REVIEW", "TRANSFORMATION_CANDIDATE"],
    ["TRANSFORMATION_CANDIDATE", "TRANSFORMATION_WINDOW"],
    ["TRANSFORMATION_WINDOW", "RECONSOLIDATION"],
    ["RECONSOLIDATION", "PLURAL_MODEL_STATE"],
    ["PLURAL_MODEL_STATE", "STABLE"]
  ]
}