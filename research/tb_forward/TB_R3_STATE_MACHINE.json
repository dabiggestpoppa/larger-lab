{
  "checkpoint": "TB-R3-PERSISTENCE-RECONCILIATION",
  "description": "Frozen R3 durable basket lifecycle state machine. Distinct from (and coexisting with) the ADOPTED atomic-execution layer's internal BasketState (PENDING/PRECHECK/SENDING/VERIFYING/OPEN/...). This machine expresses durable basket truth across restarts.",
  "states": [
    "NO_BASKET",
    "SIGNAL_DETECTED",
    "INTENT_CREATED",
    "ENTRY_SUBMITTING",
    "PARTIALLY_FILLED",
    "OPEN_VERIFIED",
    "CLOSE_REQUESTED",
    "CLOSE_SUBMITTING",
    "PARTIALLY_CLOSED",
    "CLOSED_VERIFIED",
    "BROKEN_HEDGE",
    "FLATTENING",
    "FLAT_VERIFIED",
    "RECONCILIATION_REQUIRED",
    "BLOCKED_UNKNOWN_STATE"
  ],
  "terminal_states": ["BLOCKED_UNKNOWN_STATE"],
  "transitions": [
    ["NO_BASKET", "SIGNAL_DETECTED", "strategy entry signal observed on a closed M5 bar"],
    ["SIGNAL_DETECTED", "NO_BASKET", "signal rejected (session/quality/neutrality gate)"],
    ["SIGNAL_DETECTED", "INTENT_CREATED", "basket intent durably persisted (write-ahead before any order)"],
    ["INTENT_CREATED", "ENTRY_SUBMITTING", "entry attempt started (first broker order sent)"],
    ["INTENT_CREATED", "FLAT_VERIFIED", "entry never submitted (aborted before any order)"],
    ["ENTRY_SUBMITTING", "ENTRY_SUBMITTING", "bounded retry / duplicate-response idempotent no-op"],
    ["ENTRY_SUBMITTING", "OPEN_VERIFIED", "all three legs filled + broker-verified"],
    ["ENTRY_SUBMITTING", "PARTIALLY_FILLED", "1-2 of 3 legs filled"],
    ["ENTRY_SUBMITTING", "FLAT_VERIFIED", "zero fills, aborted flat"],
    ["PARTIALLY_FILLED", "BROKEN_HEDGE", "partial triangle detected"],
    ["BROKEN_HEDGE", "FLATTENING", "flatten started for filled legs"],
    ["FLATTENING", "FLAT_VERIFIED", "all filled legs confirmed flat"],
    ["FLATTENING", "BLOCKED_UNKNOWN_STATE", "flatten unresolved"],
    ["OPEN_VERIFIED", "CLOSE_REQUESTED", "canonical exit signal observed"],
    ["CLOSE_REQUESTED", "CLOSE_SUBMITTING", "close attempt started"],
    ["CLOSE_SUBMITTING", "CLOSED_VERIFIED", "all three legs confirmed flat"],
    ["CLOSE_SUBMITTING", "PARTIALLY_CLOSED", "1-2 of 3 legs closed"],
    ["PARTIALLY_CLOSED", "CLOSE_SUBMITTING", "bounded close retry"],
    ["CLOSED_VERIFIED", "NO_BASKET", "basket lifecycle complete (re-entry allowed)"],
    ["RECONCILIATION_REQUIRED", "OPEN_VERIFIED", "reconciled: all expected legs present at broker"],
    ["RECONCILIATION_REQUIRED", "FLAT_VERIFIED", "reconciled: broker confirmed flat"],
    ["RECONCILIATION_REQUIRED", "BROKEN_HEDGE", "reconciled: partial triangle confirmed"],
    ["OPEN_VERIFIED", "RECONCILIATION_REQUIRED", "broker/local divergence (manual intervention or unknown change)"],
    ["CLOSE_SUBMITTING", "RECONCILIATION_REQUIRED", "close cannot complete; reconcile before any action"],
    ["RECONCILIATION_REQUIRED", "BLOCKED_UNKNOWN_STATE", "reconciliation cannot determine truth"]
  ],
  "enforcement": "persistence.append_event validates (prior_state, new_state) against this frozen graph BEFORE commit; an invalid pair raises ValueError and nothing is written (fail closed).",
  "scientific_changes": "NONE"
}
