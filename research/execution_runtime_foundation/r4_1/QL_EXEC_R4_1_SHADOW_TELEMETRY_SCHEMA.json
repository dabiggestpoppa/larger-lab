{
  "schema": "QL_EXEC_R4_1_SHADOW_TELEMETRY_SCHEMA",
  "version": 1,
  "description": "Read-only shadow telemetry snapshot. No secrets; broker_write_calls and shadow_order_attempts MUST remain 0.",
  "required_fields": [
    "runtime_id",
    "deployment_generation",
    "shadow_mode",
    "broker_read_connected",
    "account_identity_match",
    "latest_common_bar",
    "primary_basis",
    "primary_z",
    "primary_decision",
    "control_basis",
    "control_z",
    "control_decision",
    "legacy_primary_decision",
    "legacy_control_decision",
    "parity_status",
    "parity_mismatch_reason",
    "hypothetical_intents",
    "broker_write_calls",
    "shadow_order_attempts",
    "execution_gate_denials",
    "heartbeat",
    "blocking_reason"
  ],
  "hard_zero_fields": [
    "broker_write_calls",
    "shadow_order_attempts"
  ],
  "fields": {
    "runtime_id": { "type": "string", "const": "tb-generic-shadow-g1" },
    "deployment_generation": { "type": "string", "const": "TB-GENERIC-SHADOW-G1" },
    "shadow_mode": { "type": "string", "const": "SHADOW_OBSERVE_ONLY" },
    "broker_read_connected": { "type": "boolean" },
    "account_identity_match": { "type": "boolean" },
    "latest_common_bar": { "type": ["string", "null"] },
    "primary_basis": { "type": ["number", "null"] },
    "primary_z": { "type": ["number", "null"] },
    "primary_decision": { "type": "string" },
    "control_basis": { "type": ["number", "null"] },
    "control_z": { "type": ["number", "null"] },
    "control_decision": { "type": "string" },
    "legacy_primary_decision": { "type": ["string", "null"] },
    "legacy_control_decision": { "type": ["string", "null"] },
    "parity_status": { "type": "string", "enum": ["EXACT", "NORMALIZED_EQUIVALENT", "SAFETY_STRENGTHENING_NONREGRESSIVE", "INTENTIONAL_ARCHITECTURE_DIFFERENCE", "MISMATCH", "NOT_TESTED"] },
    "parity_mismatch_reason": { "type": ["string", "null"] },
    "hypothetical_intents": { "type": "integer", "minimum": 0 },
    "broker_write_calls": { "type": "integer", "const": 0 },
    "shadow_order_attempts": { "type": "integer", "const": 0 },
    "execution_gate_denials": { "type": "integer", "minimum": 0 },
    "heartbeat": { "type": "string", "format": "ISO-8601 UTC" },
    "blocking_reason": { "type": ["string", "null"] }
  }
}
