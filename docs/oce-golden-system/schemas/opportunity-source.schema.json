{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oce://schemas/opportunity-source/v1.0",
  "title": "OpportunitySource",
  "type": "object",
  "required": ["schema_version", "source_id", "source_name", "source_types", "machine_access", "verification_level", "health_state", "last_verified_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_id": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["META_DIRECTORY", "HUMAN_FREELANCE_MARKET", "AGENT_TASK_MARKET", "AGENT_SERVICE_MARKET", "CAPABILITY_PROCUREMENT_MARKET", "BOUNTY_COMPETITION_MARKET", "DIRECT_CLIENT_CHANNEL"]}},
    "market_model": {"type": ["string", "null"]},
    "discovery_endpoint": {"type": ["string", "null"]},
    "machine_access": {"enum": ["REST", "MCP", "SSE", "WEBHOOK", "CLI", "WEB_ONLY", "MULTI", "UNKNOWN"]},
    "auth_mode": {"type": ["string", "null"]},
    "settlement_asset": {"type": ["string", "null"]},
    "settlement_network": {"type": ["string", "null"]},
    "escrow_model": {"type": ["string", "null"]},
    "fee_model": {"type": ["string", "null"]},
    "stake_or_collateral": {"type": ["string", "null"]},
    "reputation_model": {"type": ["string", "null"]},
    "dispute_model": {"type": ["string", "null"]},
    "task_state_model": {"type": ["string", "null"]},
    "recommended_observer_mode": {"enum": ["EVENT_DRIVEN", "ADAPTIVE_POLL", "SCHEDULED_POLL", "MANUAL_ONLY", "DISABLED", "UNKNOWN"]},
    "recommended_poll_interval_minutes": {"type": ["integer", "null"], "minimum": 1},
    "rate_limits": {"type": ["object", "null"], "additionalProperties": true},
    "platform_constraints": {"type": "array", "items": {"type": "string"}},
    "geographic_constraints": {"type": "array", "items": {"type": "string"}},
    "human_checkpoint_required": {"type": ["boolean", "null"]},
    "observability": {"type": ["string", "null"]},
    "liquidity_confidence": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
    "verification_level": {"enum": ["FIRST_PARTY_CURRENT", "FIRST_PARTY_PARTIAL", "DIRECTORY_VERIFIED", "SELF_REPORTED", "UNVERIFIED", "DRIFT_DETECTED"]},
    "adapter_version": {"type": ["string", "null"]},
    "source_contract_version": {"type": ["string", "null"]},
    "last_verified_at": {"type": "string", "format": "date-time"},
    "health_state": {"enum": ["HEALTHY", "DRIFT_SUSPECTED", "READ_ONLY_REVERIFY", "VERIFIED_NEW_CONTRACT", "DISABLED"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}