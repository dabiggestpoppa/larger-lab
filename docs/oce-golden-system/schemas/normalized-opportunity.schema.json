{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oce://schemas/normalized-opportunity/v1.0",
  "title": "NormalizedOpportunity",
  "type": "object",
  "required": ["schema_version", "opportunity_id", "external_id", "source_id", "objective", "economics", "resource_estimate", "gate_status", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "opportunity_id": {"type": "string", "minLength": 1},
    "external_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "title": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "category": {"type": ["string", "null"]},
    "requirements": {"type": ["object", "array", "string", "null"]},
    "deadline": {"type": ["string", "null"], "format": "date-time"},
    "economics": {
      "type": "object",
      "required": ["gross_payout", "expected_margin"],
      "properties": {
        "gross_payout": {"type": ["number", "null"]},
        "currency": {"type": ["string", "null"]},
        "escrow_status": {"type": ["string", "null"]},
        "fee_estimate": {"type": ["number", "null"], "minimum": 0},
        "stake_required": {"type": ["number", "null"], "minimum": 0},
        "capital_at_risk": {"type": ["number", "null"], "minimum": 0},
        "estimated_win_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "acceptance_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "expected_margin": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "resource_estimate": {
      "type": "object",
      "required": ["expected_compute_cost", "expected_tool_cost", "expected_human_minutes"],
      "properties": {
        "expected_compute_cost": {"type": "number", "minimum": 0},
        "expected_tool_cost": {"type": "number", "minimum": 0},
        "expected_human_minutes": {"type": "number", "minimum": 0},
        "estimated_execution_seconds": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "capabilities_required": {"type": "array", "items": {"type": "string"}},
    "knowledge_domains": {"type": "array", "items": {"type": "string"}},
    "data_sensitivity": {"enum": ["PUBLIC", "LOW", "MODERATE", "HIGH", "RESTRICTED", "UNKNOWN"]},
    "value_vector": {
      "type": ["object", "null"],
      "properties": {
        "reusability_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "transferability_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "learning_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "strategic_alignment": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reputation_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "challenge_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "counterparty_risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reputation_risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "legal_tos_risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "human_burden": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "time_opportunity_cost": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "utility_score": {"type": ["number", "null"], "description": "Ranking aid only; never overrides a hard gate."},
    "gate_status": {"enum": ["UNASSESSED", "PASS", "REJECT", "HUMAN_REVIEW", "REVERIFY_SOURCE"]},
    "rejection_reasons": {"type": "array", "items": {"type": "string"}},
    "budget_class": {"enum": ["EXPLOIT", "EXPLORE", "STRATEGIC_BUILD", "UNASSIGNED"]},
    "provenance": {
      "type": "object",
      "required": ["observed_at", "raw_source_ref", "adapter_version"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "raw_source_ref": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "source_contract_version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}