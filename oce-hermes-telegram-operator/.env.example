# ══════════════════════════════════════════════════════════════════════════════
# OCE Hermes Telegram Operator — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your secrets.
# NEVER commit .env to git.
# NEVER log, display, or commit the actual values below.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Telegram ─────────────────────────────────────────────────────────────────
# BotFather token: paste after creating bot with @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (get from @userinfobot)
# Comma-separated for multiple users
TELEGRAM_ALLOWED_USERS=

# MUST be false in production — never set to true
TELEGRAM_ALLOW_ALL_USERS=false

# ─── OCE Backend ──────────────────────────────────────────────────────────────
# OCE backend URL (default: http://localhost:8000)
OCE_BACKEND_URL=http://localhost:8000

# OCE read-only service token (leave empty for mock mode)
OCE_SERVICE_TOKEN=

# Request timeout in seconds (default: 30)
OCE_REQUEST_TIMEOUT=30

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Maximum requests per minute per tool (default: 60)
RATE_LIMIT_PER_MINUTE=60

# ─── LLM Provider (if required by Hermes) ────────────────────────────────────
# Uncomment and configure your preferred LLM provider:
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_PATH=evidence/audit.jsonl

# ─── Hermes Profile ───────────────────────────────────────────────────────────
HERMES_PROFILE=oce-operator
