{
  "$defs": {
    "AccessClass": {
      "description": "Free-only access taxonomy (Bloc 1 §7).",
      "enum": [
        "FREE_AUTOMATED",
        "FREE_LIMITED_AUTOMATED",
        "FREE_REFERENCE_ONLY",
        "PAID_EXCLUDED",
        "UNVERIFIED"
      ],
      "title": "AccessClass",
      "type": "string"
    },
    "QualityFlag": {
      "description": "Additive per-record quality flags (Bloc 1 §12). Canonical set.",
      "enum": [
        "SOURCE_NATIVE",
        "SOURCE_AGGREGATED",
        "SOURCE_COMMUNITY",
        "RECONSTRUCTED_INTERNAL",
        "TIMESTAMP_ASSUMED",
        "TIMESTAMP_COARSE",
        "UNIT_NATIVE_ONLY",
        "UNIT_NORMALIZED",
        "UNIT_NORMALIZATION_UNAVAILABLE",
        "VENUE_NOT_DECOMPOSABLE",
        "INSTRUMENT_ID_UNRESOLVED",
        "WINDOW_SEMANTICS_UNCERTAIN",
        "PARTIAL_INTERVAL",
        "DUPLICATE_SOURCE_RECORD",
        "SOURCE_GAP",
        "STALE_SOURCE",
        "PROVIDER_DEGRADED",
        "CROSS_PROVIDER_DISAGREEMENT",
        "HISTORICAL_DEPTH_UNVERIFIED",
        "ACCESS_CLASS_UNVERIFIED",
        "PIT_RISK"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "RetrievalMode": {
      "description": "How raw source content was retrieved (Bloc 1 §6).",
      "enum": [
        "REST",
        "WS",
        "BULK_FILE",
        "COMMUNITY_ARCHIVE"
      ],
      "title": "RetrievalMode",
      "type": "string"
    },
    "SensorFamily": {
      "description": "Canonical sensor families (frozen initial set, Bloc 1 §3 / F2).",
      "enum": [
        "MECHANICAL_TRADE",
        "MECHANICAL_LIQUIDATION",
        "MECHANICAL_OPEN_INTEREST",
        "MECHANICAL_FUNDING",
        "MECHANICAL_BOOK_SNAPSHOT",
        "MECHANICAL_BOOK_METRIC",
        "MECHANICAL_POSITIONING",
        "MECHANICAL_BASIS"
      ],
      "title": "SensorFamily",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Provenance envelope bound to an immutable raw object (T0 pointer).",
  "properties": {
    "access_class": {
      "$ref": "#/$defs/AccessClass"
    },
    "adapter_version": {
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "endpoint_id": {
      "minLength": 1,
      "title": "Endpoint Id",
      "type": "string"
    },
    "envelope_id": {
      "minLength": 1,
      "title": "Envelope Id",
      "type": "string"
    },
    "http_status": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Http Status"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "quality_flags": {
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "raw_checksum": {
      "minLength": 1,
      "title": "Raw Checksum",
      "type": "string"
    },
    "raw_object_uri": {
      "minLength": 1,
      "title": "Raw Object Uri",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "request_started_at": {
      "format": "date-time",
      "title": "Request Started At",
      "type": "string"
    },
    "requested_end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested End"
    },
    "requested_start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Start"
    },
    "response_received_at": {
      "format": "date-time",
      "title": "Response Received At",
      "type": "string"
    },
    "retrieval_mode": {
      "$ref": "#/$defs/RetrievalMode"
    },
    "sensor_family_hint": {
      "$ref": "#/$defs/SensorFamily"
    },
    "source_interval": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Interval"
    },
    "source_metadata": {
      "additionalProperties": true,
      "title": "Source Metadata",
      "type": "object"
    },
    "source_symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Symbol"
    },
    "venue_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue Hint"
    }
  },
  "required": [
    "envelope_id",
    "provider",
    "sensor_family_hint",
    "endpoint_id",
    "retrieval_mode",
    "request_started_at",
    "response_received_at",
    "raw_object_uri",
    "raw_checksum",
    "access_class",
    "adapter_version"
  ],
  "title": "ProviderEnvelope",
  "type": "object"
}
