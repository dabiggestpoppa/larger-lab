  "basis_definitions": {
    "PERP_SPOT_BASIS_BPS": "10000 * ln(P_perp_close / P_spot_close)",
    "MARK_INDEX_BASIS_BPS": "10000 * ln(P_mark / P_index)  [snapshot only]",
    "PERP_INDEX_BASIS_BPS": "10000 * ln(P_perp / P_index)  [not time-series-able]"
  },
  "alignment": {
    "method": "same-bucket completed 1h bar, causal nearest-prior fallback",
    "max_staleness_hours": 1,
    "no_future_matching": true
