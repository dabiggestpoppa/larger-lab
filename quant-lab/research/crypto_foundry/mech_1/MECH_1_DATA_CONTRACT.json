  "severity_bands": {
    "NORMAL": "< p90 of |basis|",
    "ELEVATED": "p90..p97.5",
    "EXTREME": "> p97.5"
  },
  "horizons": ["1h", "4h", "8h", "24h"],
  "temporal_splits": {
    "DEVELOPMENT": "2023-05-12..2025-12-31 (funding/spot lanes)",
    "RECENT_DESCRIPTIVE": "2026-01-01..2026-08-21 (basis/AMM lanes)"
  },
  "null_models": [
    "unconditional_future_basis_change",
    "random_timestamps_matched_by_volatility_regime",
    "shuffled_event_labels_preserving_time_blocks",
    "ar1_mean_reversion_expectation"
  ],
  "fdr_method": "BH-FDR q=0.05",
  "bootstrap": {"method": "block bootstrap", "block_hours": 24, "seed": 20260821},
  "mechanism_families": [
    "SPOT_PERP_CONVERGENCE", "FUNDING_CROWDING_UNWIND",
    "OI_EXPANSION_CONTINUATION", "OI_CONTRACTION_RESOLUTION",
    "MARK_INDEX_STRESS", "AMM_REPRICE_LAG", "AMM_FLOW_CONFIRMATION",
    "BTC_ETH_CAPITAL_ROTATION", "VOLATILITY_STATE_TRANSITION",
    "TIME_EPOCH_RESOLUTION"
  ],
  "prohibited": [
    "strategy_pnl", "win_rate", "profit_factor", "sharpe", "drawdown",
    "expectancy", "xgboost", "optuna", "ml_classifiers", "grids",
    "lp_strategies", "execution", "orders", "capital", "SOL", "BNB"
  ],
  "data_limitations_recorded": [
    "perp 1h history API-capped at ~5000 bars (~7 months)",
    "mark/index/OI available as snapshots only (2 rows per asset)",
    "book available as 1 snapshot (PILOT structural observation)",
    "AMM windows are days not years (PILOT_MECHANISM_EVIDENCE)",
    "perp-spot basis lane = 2026-01-25..2026-06-15 (~3400 hourly points)",
    "cbBTC/Base demoted at DATA-1 freeze; not part of MECH-1"
  ]
