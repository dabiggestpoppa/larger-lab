  "freeze_parent": "data_1/CRYPTO_DATA_FOUNDATION_FREEZE.json",
  "assets": ["BTC", "ETH"],
  "price_objects": {
    "BINANCE_SPOT": "bn_btcusdt_spot_5m / bn_ethusdt_spot_5m",
    "HYPERLIQUID_PERP": "hl_*_perp_state_5m + hl_*_perp_candles_1h",
    "HYPERLIQUID_MARK": "hl_*_mark_index_oi_raw (snapshot)",
    "HYPERLIQUID_INDEX": "hl_*_mark_index_oi_raw (snapshot)",
