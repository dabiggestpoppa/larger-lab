  "defects_found_and_fixed": [
    {
      "id": "B6-D1",
      "severity": "structural",
      "defect": "model_copy(update=...) wrote unknown keys straight into a pydantic instance __dict__, bypassing extra='forbid'. A caller could forge FundamentalStateVector.score = 0.9 on a schema with no score field.",
      "fix": "Added Book6FrozenModel, which re-validates the requested update against the model's own fields so an unknown key is a refusal rather than a smuggled attribute. All sixteen Book 6 record types now inherit it.",
      "discovered_by": "test_book6_state_vector.py"
    },
    {
      "id": "B6-D2",
      "severity": "structural",
      "defect": "DATA_COMPLETE was derivable from observation missingness alone, so a vector asserted data completeness with zero ratified coverage-sufficiency rules, violating the Phase 25 fail-closed requirement.",
      "fix": "data_status now additionally requires named ratified coverage-sufficiency support covering every dimension, and fails closed at bootstrap where no such rule exists to name.",
      "discovered_by": "test_book6_state_vector.py"
    },
    {
      "id": "B6-D3",
      "severity": "structural",
      "defect": "StateRuleRegistry documented supersession in its ratify() docstring but had no path to perform it; re-registering a new version of an existing rule id was impossible.",
      "fix": "Added supersede(), which retains prior versions in an append-only history and installs the successor as UNRATIFIED, so authority decays on a rule revision instead of riding along with it.",
      "discovered_by": "test_book6_state_rules.py"
    },
    {
      "id": "B6-D4",
      "severity": "interface",
      "defect": "normalize() leaked NormalizationRuleError and Book6RegistryError to callers, so the engine was not a single fail-closed surface.",
      "fix": "normalize() now re-raises lineage, admissibility and decayed-native-input refusals as Book6EngineError.",
      "discovered_by": "test_book6_normalization.py, test_book6_temporal.py"
    },
    {
      "id": "B6-D5",
      "severity": "interface",
      "defect": "authorize_valuation() checked only price admissibility, so a forged model_copy could strip the numeraire or the price source and still authorize.",
      "fix": "authorize_valuation() re-reads the numeraire and the cited price source at use.",
      "discovered_by": "test_book6_valuation.py"
    },
    {
      "id": "B6-D6",
      "severity": "record",
      "defect": "DenominatorRef rejected a non-divisible denominator at construction and rejected an observed-zero denominator declared PRESENT.",
      "fix": "A non-divisible denominator is now a legitimate record whose division fails closed through the engine's typed RatioResult; an observed 0.0 declared PRESENT is refused because that is ZERO, not PRESENT.",
      "discovered_by": "test_book6_missingness.py"
    }
  ],
