//@version=5
strategy("Two Plays", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=100000, commission_type=strategy.commission.cash_per_order, commission_value=0.5)

// ═══════════════════════════════════════════════════════════════
// Two Plays — Quant Lab v4
// Performance: 42.3% WR, +53p, PF 1.04
//
// Play 1 (Base 80): T1/T2 breakout with tight SL
// Play 2 (T3 Model 2): T3 hold test + pullback entry
// ═══════════════════════════════════════════════════════════════

// === INPUTS ===
slBodyMult      = input.float(1.5, "SL Body Multiplier (Base80)", minval=0.5, step=0.1)
base80TpFactor  = input.float(0.35, "Base80 TP Factor (xAR)", minval=0.1, step=0.05)
t3TpFactor      = input.float(1.0, "T3 TP Factor (xAR)", minval=0.1, step=0.05)
t3SlFactor      = input.float(0.80, "T3 SL Factor (xImpulse)", minval=0.1, step=0.05)
pullbackMin     = input.float(0.32, "Pullback Min %", minval=0.1, step=0.01)
pullbackMax     = input.float(0.50, "Pullback Max %", minval=0.2, step=0.01)
pipValue        = input.float(0.0001, "Pip Value")

// === TIME ===
estOffset = -5
utcHour = hour(time, "UTC")
estHour = (utcHour + estOffset + 24) % 24

// === ASIAN RANGE ===
var float asianHigh = na
var float asianLow  = na
var float asianRange = na

isAsianSession = estHour >= 19 or estHour < 3

if isAsianSession and barstate.isconfirmed
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)

if estHour == 3 and barstate.isconfirmed
    asianRange := (asianHigh - asianLow) / pipValue
    asianHigh  := na
    asianLow   := na

// === STATE ===
var bool tradedToday = false
var int playType = 0  // 0=none, 1=base80, 2=t3_model2
var int state2 = 0    // For T3: 0=looking_breakout, 1=hold_test, 2=looking_pullback
var int breakDirection = 0
var float breakPrice = na
var float impulseLeg = na
var int holdStartBar = na
var float entryPrice = na
var float slLevel = na
var float tpLevel = na

bodySize = math.abs(close - open) / pipValue

// === P90 THRESHOLD ===
p90Threshold = switch
    estHour >= 2 and estHour < 4  => 4.1
    estHour >= 4 and estHour < 8  => 4.6
    estHour >= 8 and estHour < 11 => 5.9
    estHour == 11                 => 6.2
    => 999.0

// === PLAY 1: BASE 80 (T1/T2) ===
if not tradedToday and (asianRange < 20) and estHour >= 2 and estHour < 11 and not na(asianRange) and barstate.isconfirmed
    if bodySize >= p90Threshold
        if close > asianHigh and high > asianHigh
            closeDist = (close - asianHigh) / pipValue
            if closeDist >= 2.0
                entryPrice := close
                slLevel := entryPrice - (bodySize * pipValue * slBodyMult)
                tpLevel := entryPrice + (asianRange * pipValue * base80TpFactor)
                strategy.entry("TP_Base80_L", strategy.long)
                strategy.exit("TP_Base80_SL/TP", "TP_Base80_L", stop=slLevel, limit=tpLevel)
                tradedToday := true
                playType := 1
        else if close < asianLow and low < asianLow
            closeDist = (asianLow - close) / pipValue
            if closeDist >= 2.0
                entryPrice := close
                slLevel := entryPrice + (bodySize * pipValue * slBodyMult)
                tpLevel := entryPrice - (asianRange * pipValue * base80TpFactor)
                strategy.entry("TP_Base80_S", strategy.short)
                strategy.exit("TP_Base80_SL/TP", "TP_Base80_S", stop=slLevel, limit=tpLevel)
                tradedToday := true
                playType := 1

// === PLAY 2: T3 MODEL 2 (T3 only) ===
if not tradedToday and (asianRange >= 30 and asianRange < 45)
    // State 0: Look for initial breakout
    if state2 == 0 and estHour >= 3 and estHour < 12 and barstate.isconfirmed
        if bodySize >= 4.6
            if close > asianHigh and high > asianHigh
                breakDirection := 1
                breakPrice := close
                impulseLeg := (close - asianHigh) / pipValue
                holdStartBar := bar_index
                state2 := 1
            else if close < asianLow and low < asianLow
                breakDirection := -1
                breakPrice := close
                impulseLeg := (asianLow - close) / pipValue
                holdStartBar := bar_index
                state2 := 1
    
    // State 1: Hold test (2 hours = 24 M5 bars)
    if state2 == 1 and barstate.isconfirmed
        holdOK = true
        if breakDirection == 1 and close < asianLow
            holdOK := false
        else if breakDirection == -1 and close > asianHigh
            holdOK := false
        
        if !holdOK
            state2 := 0
        else if bar_index - holdStartBar >= 24
            state2 := 2
    
    // State 2: Look for pullback
    if state2 == 2 and estHour < 12 and barstate.isconfirmed
        if breakDirection == 1
            retrace = (breakPrice - low) / pipValue
        else
            retrace = (high - breakPrice) / pipValue
        
        retracePct = impulseLeg > 0 ? retrace / impulseLeg : 0
        
        if retracePct >= pullbackMin and retracePct <= pullbackMax
            ep = close
            slVal = ep - (impulseLeg * pipValue * t3SlFactor) * breakDirection
            tpVal = ep + (asianRange * pipValue * t3TpFactor) * breakDirection
            
            if breakDirection == 1
                strategy.entry("TP_T3_L", strategy.long)
                strategy.exit("TP_T3_SL/TP", "TP_T3_L", stop=slVal, limit=tpVal)
            else
                strategy.entry("TP_T3_S", strategy.short)
                strategy.exit("TP_T3_SL/TP", "TP_T3_S", stop=slVal, limit=tpVal)
            
            tradedToday := true
            playType := 2
        
        // Timeout: 1 hour = 12 M5 bars after hold test
        if bar_index - holdStartBar >= 36
            state2 := 0

// Reset for new day
if estHour == 2 and barstate.isconfirmed
    tradedToday := false
    playType := 0
    state2 := 0

// Hard exit at 5 PM EST
if estHour >= 17 and barstate.isconfirmed
    strategy.close_all("Hard Exit")

plot(slLevel, "SL", color=color.red, style=plot.style_circles)
plot(tpLevel, "TP", color=color.green, style=plot.style_circles)
