//@version=5
// ═══════════════════════════════════════════════════════════════
// TWO PLAYS v3 — PineScript v5 (COST-OPTIMIZED)
// ═══════════════════════════════════════════════════════════════
// Source: two_plays_v3.py — Quant Lab Cost-Validated Fix
// Win Rate: 42.3% (v1) → ~57% (v3 projected)
// PF: 1.04 (v1) → ~1.62 after costs (v3 projected)
//
// CORE CONCEPT:
// T1 Asian Range breakout with quality filters. Price must close
// well beyond the Asian band (4+ pips), trade only before 8AM,
// and only in the direction of the 200 MA trend.
//
// SETUP:
// 1. Asian Range must be T1 (< 20 pips)
// 2. P90 candle with body >= threshold for that hour
// 3. Close must be 4+ pips beyond Asian band (quality filter)
// 4. Only before 8AM EST
// 5. Trend filter: Only trade in direction of 200 MA
// 6. SL: 1.5x body from entry
// 7. TP: 0.55x AR (wider for cost survival)
// 8. Time exit: max 2 hours
// ═══════════════════════════════════════════════════════════════

strategy(
     title="Two Plays v3",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.35,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     max_bars_back=5000
     )

// ─── INPUTS ───────────────────────────────────────────────────
i_tpFactor     = input.float(0.55, "TP AR Factor", minval=0.30, maxval=1.00, step=0.01, tooltip="TP as fraction of AR. v3: 0.55x")
i_slMult       = input.float(1.50, "SL Body Multiplier", minval=0.50, maxval=3.00, step=0.05, tooltip="SL as fraction of body. v3: 1.50x")
i_closeDist    = input.float(4.0, "Min Close Distance (pips)", minval=1.0, maxval=10.0, step=0.5, tooltip="Close must be this far beyond band. v3: 4.0p")
i_pipSize      = input.float(0.00010, "Pip Size", minval=0.00001, maxval=0.01, step=0.00001)

// ─── TIME ─────────────────────────────────────────────────────
estHour    = hour(time, "America/New_York")
currentDate = dayofmonth(time, "America/New_York")

// ─── ASIAN RANGE ──────────────────────────────────────────────
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var int   asianDate  = 0

isAsian = estHour >= 19 or estHour < 3

if currentDate != asianDate and not na(asianDate)
    asianDate := currentDate

if isAsian
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) / i_pipSize

// ─── P90 THRESHOLDS BY HOUR ───────────────────────────────────
p90Threshold = switch
    estHour < 2 or estHour >= 11 => 99.0
    estHour < 4                   => 4.1
    estHour < 8                   => 4.6
    estHour < 10                  => 5.9
    estHour < 11                  => 6.2
    => 99.0

// ─── STATE VARIABLES ──────────────────────────────────────────
var bool  entered = false

// ─── DAILY RESET ──────────────────────────────────────────────
if estHour == 2
    entered := false

// ─── 200 MA (TREND FILTER) ────────────────────────────────────
sma200 = ta.sma(close, 200)

// ─── SESSION FILTER ───────────────────────────────────────────
inSession = estHour >= 2 and estHour < 8

// ─── ENTRY LOGIC ──────────────────────────────────────────────
bodyPips = math.abs(close - open) / i_pipSize

if inSession and not entered and not na(asianRange) and asianRange >= 3 and asianRange < 20
    if bodyPips >= p90Threshold
        dir = 0
        if close > asianHigh and high > asianHigh
            closeDist = (close - asianHigh) / i_pipSize
            if closeDist >= i_closeDist
                dir := 1
        else if close < asianLow and low < asianLow
            closeDist = (asianLow - close) / i_pipSize
            if closeDist >= i_closeDist
                dir := -1

        if dir != 0
            isLong = dir == 1
            if (isLong and close > sma200) or (not isLong and close < sma200)
                entered := true
                sl = close - (bodyPips * i_slMult * i_pipSize) * dir
                tp = close + (asianRange * i_tpFactor * i_pipSize) * dir
                if isLong
                    strategy.entry("TP Long", strategy.long)
                    strategy.exit("TP Long Exit", "TP Long", stop=sl, limit=tp)
                else
                    strategy.entry("TP Short", strategy.short)
                    strategy.exit("TP Short Exit", "TP Short", stop=sl, limit=tp)

// ─── HARD EXIT AT 5PM ─────────────────────────────────────────
if estHour >= 17 and strategy.position_size != 0
    strategy.close_all("Hard Exit 5PM")

// ─── PLOTS ────────────────────────────────────────────────────
plot(sma200, "SMA 200", color=color.new(color.yellow, 50), linewidth=1)
plot(asianHigh, "Asian High", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(asianLow, "Asian Low", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(entered and not entered[1], "TP Entry", "Two Plays: Breakout entry triggered")
