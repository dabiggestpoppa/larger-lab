//@version=5
strategy("P90P Distribution", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=100000, commission_type=strategy.commission.cash_per_order, commission_value=0.5)

// ═══════════════════════════════════════════════════════════════
// P90P Distribution Tracker — Quant Lab v4
// Performance: 20.0% WR, +150p, PF 1.14
//
// Logic: P90 breakout with regime-filtered AR-based targets.
// ═══════════════════════════════════════════════════════════════

// === INPUTS ===
slBodyMult    = input.float(0.80, "SL Body Multiplier", minval=0.1, step=0.05)
pipValue      = input.float(0.0001, "Pip Value")

// === TIME ===
estOffset = -5
utcHour = hour(time, "UTC")
estHour = (utcHour + estOffset + 24) % 24
isEntryWindow = estHour >= 2 and estHour < 11

// === ASIAN RANGE ===
var float asianHigh = na
var float asianLow  = na
var float asianRange = na

isAsianSession = estHour >= 19 or estHour < 3

if isAsianSession and barstate.isconfirmed
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)

if estHour == 3 and barstate.isconfirmed
    asianRange := (asianHigh - asianLow) / pipValue
    asianHigh  := na
    asianLow   := na

// === STATE ===
var bool tradedToday = false
var float entryPrice = na
var float slLevel = na
var float tpLevel = na

bodySize = math.abs(close - open) / pipValue

// === P90 DETECTION ===
p90Threshold = switch
    estHour >= 2 and estHour < 4  => 4.1
    estHour >= 4 and estHour < 8  => 4.6
    estHour >= 8 and estHour < 11 => 5.9
    estHour == 11                 => 6.2
    => 999.0

isP90 = isEntryWindow and not na(asianRange) and bodySize >= p90Threshold and asianRange >= 3.0 and asianRange <= 45.0

// === REGIME DETECTION (at 9 AM EST) ===
var string regime = "NEUTRAL"
if estHour == 9 and barstate.isconfirmed and not na(asianRange)
    // Calculate daily range so far (3 AM - 9 AM)
    dailyHigh = ta.highest(high, 72)  // 72 M5 bars = 6 hours
    dailyLow  = ta.lowest(low, 72)
    dailyRange = (dailyHigh - dailyLow) / pipValue
    regimeRatio = dailyRange / asianRange
    if regimeRatio >= 1.50
        regime := "CONFIRMED"
    else if regimeRatio < 1.45
        regime := "FAILED"
    else
        regime := "NEUTRAL"

// === ENTRY ===
if isP90 and not tradedToday and barstate.isconfirmed
    ep = close
    dir = close > open ? 1 : -1
    
    // Must close outside Asian band
    if dir == 1 and ep > asianHigh
        tier = asianRange < 20 ? "T1" : asianRange < 30 ? "T2" : "T3"
        tierFactor = tier == "T1" ? 1.80 : tier == "T2" ? 1.50 : 1.20
        
        // Regime filter
        if regime != "FAILED"
            fraction = regime == "CONFIRMED" ? 0.70 : 0.55
            targetPips = asianRange * tierFactor * fraction
            
            entryPrice := ep
            slLevel := ep - (bodySize * pipValue * slBodyMult) * dir
            tpLevel := ep + (targetPips * pipValue) * dir
            
            if dir == 1
                strategy.entry("P90P_Long", strategy.long)
                strategy.exit("P90P_SL/TP", "P90P_Long", stop=slLevel, limit=tpLevel)
            else
                strategy.entry("P90P_Short", strategy.short)
                strategy.exit("P90P_SL/TP", "P90P_Short", stop=slLevel, limit=tpLevel)
            
            tradedToday := true

// Reset for new day
if estHour == 2 and barstate.isconfirmed
    tradedToday := false
    regime := "NEUTRAL"

// Hard exit at 5 PM EST
if estHour >= 17 and barstate.isconfirmed
    strategy.close_all("Hard Exit")

plot(slLevel, "SL", color=color.red, style=plot.style_circles)
plot(tpLevel, "TP", color=color.green, style=plot.style_circles)
