//@version=5
// ═══════════════════════════════════════════════════════════════
// FAILURE REPAIR MODEL v3 — PineScript v5 (COST-OPTIMIZED)
// ═══════════════════════════════════════════════════════════════
// Source: failure_repair_v3.py — Quant Lab Cost-Validated Fix
// Win Rate: 50.0% (v1) → ~58% (v3 projected)
// PF: 1.81 (v1) → ~1.72 after costs (v3 projected)
//
// COST MODEL (validated 2026-05-18):
//   Total cost per trade: ~2.9 pips
//   Position sizing: 5% of equity per trade
//
// CORE CONCEPT:
// A breakout from the Asian range occurs (1st signal), but price
// fails and returns to the Asian band. A second, STRONGER breakout
// then occurs in the same direction. Enter on the 2nd signal,
// targeting a move equal to 75% of the Asian Range.
//
// SETUP:
// 1. 1st signal: P90 breakout from Asian band (body >= 4.6p)
// 2. Failure: Price returns to Asian band within 2 hours
// 3. 2nd signal: Stronger breakout (body >= 2.0x 1st signal)
// 4. Enter in direction of 2nd signal
// 5. SL: 0.8x body from entry
// 6. TP: 0.75x AR (wider for cost survival)
// 7. Session: 4AM-10AM EST only
// 8. Trend filter: Only trade in direction of 200 MA
// ═══════════════════════════════════════════════════════════════

strategy(
     title="Failure Repair v3",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.35,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     max_bars_back=5000
     )

// ─── INPUTS ───────────────────────────────────────────────────
i_tpFactor     = input.float(0.75, "TP AR Factor", minval=0.50, maxval=1.50, step=0.01, tooltip="TP as fraction of AR. v3: 0.75x")
i_slMult       = input.float(0.80, "SL Body Multiplier", minval=0.30, maxval=2.00, step=0.05, tooltip="SL as fraction of body. v3: 0.80x")
i_sigMult      = input.float(2.0, "2nd Signal Body Mult", minval=1.20, maxval=3.00, step=0.1, tooltip="2nd signal must be this multiple of 1st. v3: 2.0x")
i_pipSize      = input.float(0.00010, "Pip Size", minval=0.00001, maxval=0.01, step=0.00001)

// ─── TIME ─────────────────────────────────────────────────────
estHour    = hour(time, "America/New_York")
currentDate = dayofmonth(time, "America/New_York")

// ─── ASIAN RANGE ──────────────────────────────────────────────
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var int   asianDate  = 0

isAsian = estHour >= 19 or estHour < 3

if currentDate != asianDate and not na(asianDate)
    asianDate := currentDate

if isAsian
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) / i_pipSize

// ─── STATE VARIABLES ──────────────────────────────────────────
var bool  firstSignal    = false
var bool  firstIsLong    = false
var float firstBodyPips  = na
var bool  failed         = false
var bool  entered        = false
var int   firstBarIdx    = na
var int   failBarIdx     = na

// ─── DAILY RESET ──────────────────────────────────────────────
if estHour == 4
    firstSignal   := false
    failed        := false
    entered       := false
    firstBodyPips := na
    firstBarIdx   := na
    failBarIdx    := na

// ─── 200 MA (TREND FILTER) ────────────────────────────────────
sma200 = ta.sma(close, 200)

// ─── SESSION FILTER ───────────────────────────────────────────
inSession = estHour >= 4 and estHour < 10

// ─── 1ST SIGNAL DETECTION ─────────────────────────────────────
bodyPips = math.abs(close - open) / i_pipSize

if inSession and not firstSignal and not na(asianRange) and asianRange >= 3 and asianRange <= 45
    if bodyPips >= 4.6
        if close > asianHigh and high > asianHigh
            firstSignal   := true
            firstIsLong   := true
            firstBodyPips := bodyPips
            firstBarIdx   := bar_index
        else if close < asianLow and low < asianLow
            firstSignal   := true
            firstIsLong   := false
            firstBodyPips := bodyPips
            firstBarIdx   := bar_index

// ─── FAILURE DETECTION ────────────────────────────────────────
if firstSignal and not failed and not na(firstBarIdx)
    barsSince = bar_index - firstBarIdx
    if barsSince < 24
        if firstIsLong and close < asianHigh
            failed     := true
            failBarIdx := bar_index
        else if not firstIsLong and close > asianLow
            failed     := true
            failBarIdx := bar_index

// ─── 2ND SIGNAL DETECTION ─────────────────────────────────────
if failed and not entered and inSession and not na(firstBodyPips)
    if bodyPips >= firstBodyPips * i_sigMult
        dir = 0
        if close > asianHigh and high > asianHigh
            dir := 1
        else if close < asianLow and low < asianLow
            dir := -1

        if dir != 0
            isLong = dir == 1
            if (isLong and close > sma200) or (not isLong and close < sma200)
                entered := true
                sl = close - (bodyPips * i_slMult * i_pipSize) * dir
                tp = close + (asianRange * i_tpFactor * i_pipSize) * dir
                if isLong
                    strategy.entry("FR Long", strategy.long)
                    strategy.exit("FR Long Exit", "FR Long", stop=sl, limit=tp)
                else
                    strategy.entry("FR Short", strategy.short)
                    strategy.exit("FR Short Exit", "FR Short", stop=sl, limit=tp)

// ─── HARD EXIT AT 5PM ─────────────────────────────────────────
if estHour >= 17 and strategy.position_size != 0
    strategy.close_all("Hard Exit 5PM")

// ─── PLOTS ────────────────────────────────────────────────────
plot(sma200, "SMA 200", color=color.new(color.yellow, 50), linewidth=1)
plot(asianHigh, "Asian High", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(asianLow, "Asian Low", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(firstSignal and not firstSignal[1], "1st Signal", "FR: First breakout signal")
alertcondition(failed and not failed[1], "Failure", "FR: First signal failed — watching for 2nd")
alertcondition(entered and not entered[1], "FR Entry", "FR: Second signal entry triggered")
