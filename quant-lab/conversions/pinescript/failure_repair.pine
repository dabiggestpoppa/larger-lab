//@version=5
strategy("Failure Repair", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=100000, commission_type=strategy.commission.cash_per_order, commission_value=0.5)

// ═══════════════════════════════════════════════════════════════
// Failure Repair — CEREBUS FX v4.0
// Performance: 50.0% WR, +817p, PF 1.81
//
// Logic: When an initial breakout from the Asian range fails (price
// returns to the Asian band), wait for a second breakout attempt in
// the same direction. The "repair" of the failed move often produces
// a strong continuation.
//
// SETUP:
// 1. First Signal: P90 candle breaks above/below Asian band
// 2. Failure: Price returns to Asian band within 2 hours
// 3. Second Signal: Another P90 candle in same direction
// 4. Hold Test: Price must hold above/below opposite Asian band for 2 hours
// 5. Entry: At second signal close
// 6. SL: 1.0x body from entry
// 7. TP: AR * 0.50 in trade direction
// ═══════════════════════════════════════════════════════════════

// === INPUTS ===
asianRangeMin      = input.float(3.0, "Asian Range Min (pips)", minval=1.0)
asianRangeMax      = input.float(45.0, "Asian Range Max (pips)", minval=10.0)
slBodyMult         = input.float(1.0, "SL Body Multiplier", minval=0.1, step=0.1)
tpARFactor         = input.float(0.50, "TP AR Factor", minval=0.1, step=0.05)
failWindowBars     = input.int(12, "Failure Window (bars, 5min)", minval=1)
holdWindowBars     = input.int(12, "Hold Window (bars, 5min)", minval=1)
pipValue           = input.float(0.0001, "Pip Value (EUR/USD=0.0001)")

// === TIME FILTERS ===
estOffset = -5  // UTC to EST
utcHour = hour(time, "UTC")
estHour = (utcHour + estOffset + 24) % 24

isEntryWindow = estHour >= 3 and estHour < 12   // Entry window
isTradeWindow = estHour < 17                      // Hard exit at 5 PM EST

// === ASIAN RANGE CALCULATION (7PM - 3AM EST) ===
var float asianHigh = na
var float asianLow = na
var float asianRange = na

isAsianSession = estHour >= 19 or estHour < 3

if isAsianSession and barstate.isconfirmed
    if na(asianHigh)
        asianHigh := high
        asianLow := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow := math.min(asianLow, low)

// Reset Asian range at 3 AM EST
if estHour == 3 and barstate.isconfirmed
    asianRange := (asianHigh - asianLow) / pipValue
    asianHigh := na
    asianLow := na

// === P90 THRESHOLDS BY HOUR ===
p90Threshold = switch
    estHour >= 0  and estHour < 2  => 99.0
    estHour >= 2  and estHour < 4  => 4.1
    estHour >= 4  and estHour < 8  => 4.6
    estHour >= 8  and estHour < 11 => 5.9
    estHour == 11                  => 6.2
    => 999.0

// === P90 DETECTION ===
bodySize = math.abs(close - open) / pipValue
isP90 = isEntryWindow and not na(asianRange) and bodySize >= p90Threshold and asianRange >= asianRangeMin and asianRange <= asianRangeMax

// === STATE MACHINE ===
// States: 0=idle, 1=first_signal, 2=failed, 3=second_signal, 4=entered
var int state = 0
var int firstDirection = 0    // 1=LONG, -1=SHORT
var float entryPrice = na
var float slLevel = na
var float tpLevel = na
var float bodyPipsAtEntry = na
var int barsSinceFirst = 0
var int barsSinceSecond = 0

// === STATE 0: IDLE — Look for first P90 signal ===
if state == 0 and isP90 and barstate.isconfirmed
    dir = close > open ? 1 : -1
    // Must break outside Asian band
    if dir == 1 and close > ah
        firstDirection := 1
        state := 1
        barsSinceFirst := 0
    else if dir == -1 and close < al
        firstDirection := -1
        state := 1
        barsSinceFirst := 0

// === STATE 1: FIRST SIGNAL — Check for failure ===
if state == 1
    barsSinceFirst += 1
    // Check if price returned to Asian band (failure)
    if barstate.isconfirmed
        if firstDirection == 1 and close < asianHigh
            state := 2  // Failed
        else if firstDirection == -1 and close > asianLow
            state := 2  // Failed
    // Timeout: if too many bars pass without failure, reset
    if barsSinceFirst > failWindowBars
        state := 0

// === STATE 2: FAILED — Look for second P90 in same direction ===
if state == 2 and isP90 and barstate.isconfirmed
    dir = close > open ? 1 : -1
    if dir == firstDirection
        // Second signal in same direction
        entryPrice := close
        bodyPipsAtEntry := bodySize
        state := 3
        barsSinceSecond := 0

// === STATE 3: SECOND SIGNAL — Hold test ===
if state == 3
    barsSinceSecond += 1
    holdOK = true
    if barstate.isconfirmed
        if firstDirection == 1 and close < asianLow
            holdOK := false
        else if firstDirection == -1 and close > asianHigh
            holdOK := false
    
    if not holdOK
        state := 0  // Hold test failed, reset
    else if barsSinceSecond >= holdWindowBars
        // Hold test passed — ENTER TRADE
        arPips = asianRange
        bodyInPrice = bodyPipsAtEntry * pipValue
        sign = firstDirection
        
        slLevel := entryPrice - bodyInPrice * slBodyMult * sign
        tpLevel := entryPrice + (arPips * pipValue * tpARFactor) * sign
        
        tradeDir = firstDirection == 1 ? "LONG" : "SHORT"
        if tradeDir == "LONG"
            strategy.entry("FR_Long", strategy.long)
            strategy.exit("FR_SL/TP", "FR_Long", stop=slLevel, limit=tpLevel)
        else
            strategy.entry("FR_Short", strategy.short)
            strategy.exit("FR_SL/TP", "FR_Short", stop=slLevel, limit=tpLevel)
        
        state := 4

// === STATE 4: IN TRADE — Reset after exit ===
if state == 4 and strategy.position_size == 0
    state := 0
    entryPrice := na
    slLevel := na
    tpLevel := na

// === HARD EXIT AT 5 PM EST ===
if estHour >= 17 and barstate.isconfirmed
    strategy.close_all("Hard Exit 5PM")
    state := 0

// === PLOTTING ===
plot(slLevel, "SL", color=color.red, style=plot.style_circles)
plot(tpLevel, "TP", color=color.green, style=plot.style_circles)
plot(entryPrice, "Entry", color=color.blue, style=plot.style_circles)
