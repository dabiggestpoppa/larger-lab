//@version=5
// ═══════════════════════════════════════════════════════════════
// DEEP MEAN REVERSION STRATEGY — PineScript v5 (REFINED)
// ═══════════════════════════════════════════════════════════════
// Source: optimizer_v4.py → run_deep_mean_reversion()
// Win Rate: 91.8% (backtest) | ~89.3% (after costs)
// PF: 112 (backtest) | ~45 (after costs)
// 
// COST MODEL (validated 2026-05-18):
//   Spread: 0.2 pips (EUR/USD median)
//   Commission: $7/lot round-turn
//   Slippage: 1 pip entry + 1 pip exit
//   Total cost per trade: ~2.9 pips
//   Position sizing: 5% of equity per trade
//
// CORE CONCEPT:
// When price extends aggressively to the 200% Deep State level
// (measured from P90 activation), enter mean reversion targeting
// return to the activation level.
//
// SETUP:
// 1. P90 candle sets direction and activation level (close price)
// 2. Deep State = activation + 200% of P90 body in P90 direction
// 3. Kill Switch = activation + 220% of P90 body in P90 direction
// 4. Wait for price to touch Deep State
// 5. Enter mean reversion (AGAINST P90 direction) at Deep State
// 6. SL: Kill Switch level
// 7. TP: Return to activation level
// 8. Entry must occur before 12:00 PM EST
// ═══════════════════════════════════════════════════════════════

strategy(
     title="Deep Mean Reversion",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,           // 5% risk per trade (cost-validated)
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.35,         // $7/lot × 0.05 lots = $0.35 (scaled to 5% risk)
     slippage=2,                    // 2 ticks slippage (conservative)
     pyramiding=0,                  // No pyramiding — one trade per signal
     calc_on_every_tick=false,      // Calculate on bar close only
     max_bars_back=5000             // Sufficient lookback for session tracking
     )

// ─── INPUTS ───────────────────────────────────────────────────
// Core strategy parameters (tuned from optimizer_v4)
i_deepMult     = input.float(2.00, "Deep State Multiplier", minval=1.50, maxval=3.00, step=0.01, tooltip="Deep State as % of P90 body. Default: 200%")
i_killMult     = input.float(2.20, "Kill Switch Multiplier", minval=1.80, maxval=3.00, step=0.01, tooltip="Kill Switch as % of P90 body. Default: 220%")
i_maxAR        = input.int(45, "Max Asian Range (pips)", minval=20, maxval=60, tooltip="Maximum Asian Range in pips")
i_minAR        = input.int(3, "Min Asian Range (pips)", minval=1, maxval=15, tooltip="Minimum Asian Range in pips")
i_pipSize      = input.float(0.00010, "Pip Size", minval=0.00001, maxval=0.01, step=0.00001, tooltip="Pip size in price (0.0001 for EUR/USD, 0.01 for JPY pairs)")
i_riskPct      = input.float(5.0, "Risk % per Trade", minval=1.0, maxval=10.0, step=0.5, tooltip="Percentage of equity to risk per trade")

// ─── TIME CALCULATION ─────────────────────────────────────────
// All logic operates in EST (UTC-5)
estHour    = hour(time, "America/New_York")
estMinute  = minute(time, "America/New_York")
currentDate = dayofmonth(time, "America/New_York")

// Session flags
isAsian    = estHour >= 19 or estHour < 3        // Asian session: 7PM-3AM EST
isEntry    = estHour >= 2 and estHour < 11        // Entry window: 2AM-11AM EST
isPreNoon  = estHour < 12                         // Before noon cutoff
isTradeable = estHour < 17                        // Trading window: before 5PM EST

// ─── ASIAN RANGE CALCULATION ──────────────────────────────────
// Track the Asian session high/low from 7PM EST to 3AM EST
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var int   asianDate  = 0

// Reset at the start of each new trading day
if currentDate != asianDate and not na(asianDate)
    asianDate := currentDate

// Build Asian range during Asian session hours
if isAsian
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) / i_pipSize

// ─── P90 THRESHOLD BY HOUR ───────────────────────────────────
// P90 body size thresholds vary by EST hour (from optimizer_v4)
// These represent the minimum candle body (in pips) to qualify as P90
p90Threshold = switch
    estHour < 2 or estHour >= 11 => 99.0   // Outside entry window — impossible threshold
    estHour < 4                   => 4.1    // 2AM-4AM: quiet session, lower threshold
    estHour < 8                   => 4.6    // 4AM-8AM: London open, moderate threshold
    estHour < 10                  => 5.9    // 8AM-10AM: NY/London overlap, higher threshold
    estHour < 11                  => 6.2    // 10AM-11AM: late window, highest threshold
    => 99.0

// ─── STATE VARIABLES ──────────────────────────────────────────
// These persist across bars and are reset each session
var bool  p90Found    = false      // Has a P90 candle been detected?
var float activation  = na         // P90 close price (mean reversion target)
var float p90BodyPips = na         // P90 body size in pips
var bool  p90IsLong   = false      // P90 direction (true = bullish candle)
var float deepState   = na         // Deep State level (200% of P90 body from activation)
var float killSwitch  = na         // Kill Switch level (220% of P90 body from activation)
var bool  deepTouched = false      // Has price touched the Deep State level?
var bool  entered     = false      // Has an entry been executed?

// ─── P90 DETECTION ────────────────────────────────────────────
// A P90 candle is the first candle in the entry window (2AM-11AM EST)
// with a body >= the threshold for that hour, AND the Asian Range
// is within the valid range (3-45 pips).
bodyPips = math.abs(close - open) / i_pipSize

if isEntry and not p90Found and bodyPips >= p90Threshold and asianRange >= i_minAR and asianRange <= i_maxAR
    p90Found    := true
    activation  := close                    // Activation = P90 close
    p90BodyPips := bodyPips
    p90IsLong   := close > open            // Direction of P90 candle
    // Calculate Deep State and Kill Switch levels
    // Deep State = activation + 200% of P90 body in P90 direction
    // Kill Switch = activation + 220% of P90 body in P90 direction
    bodyPrice   = p90BodyPips * i_pipSize  // Convert pips to price
    deepState   := activation + bodyPrice * i_deepMult * (p90IsLong ? 1 : -1)
    killSwitch  := activation + bodyPrice * i_killMult * (p90IsLong ? 1 : -1)

// ─── DAILY RESET ──────────────────────────────────────────────
// Reset all state at 2AM EST (start of new trading session)
if estHour == 2
    p90Found    := false
    deepTouched := false
    entered     := false

// ─── DEEP STATE TOUCH DETECTION ───────────────────────────────
// After P90 is found, check if price touches the Deep State level.
// For LONG P90: price must drop to or below Deep State (mean reversion down)
// For SHORT P90: price must rise to or above Deep State (mean reversion up)
if p90Found and not deepTouched and isPreNoon
    if p90IsLong and low <= deepState
        deepTouched := true
    else if not p90IsLong and high >= deepState
        deepTouched := true

// ─── ENTRY EXECUTION ──────────────────────────────────────────
// Enter mean reversion trade when Deep State has been touched.
// Direction is OPPOSITE to P90 direction (mean reversion).
// Entry: at Deep State level (limit order)
// SL: Kill Switch level
// TP: Activation level (return to P90 close)
entryDir = p90IsLong ? "Short" : "Long"
revIsLong = not p90IsLong

if deepTouched and not entered and strategy.position_size == 0 and isTradeable
    entered := true
    if revIsLong
        // P90 was bullish → enter SHORT (mean reversion down)
        strategy.entry("DMR Long", strategy.long, limit=deepState)
        strategy.exit("DMR Long Exit", "DMR Long", stop=killSwitch, limit=activation)
    else
        // P90 was bearish → enter LONG (mean reversion up)
        strategy.entry("DMR Short", strategy.short, limit=deepState)
        strategy.exit("DMR Short Exit", "DMR Short", stop=killSwitch, limit=activation)

// ─── HARD EXIT AT 5PM EST ─────────────────────────────────────
// Close any open position at 5PM EST to avoid overnight risk
if estHour >= 17 and strategy.position_size != 0
    strategy.close_all("Hard Exit 5PM")

// ─── PLOTS ────────────────────────────────────────────────────
// Visualize key levels on the chart
plot(activation, "Activation Level (TP)", color=color.new(color.blue, 30), linewidth=2, style=plot.style_linebr)
plot(deepState, "Deep State (Entry)", color=color.new(color.purple, 30), linewidth=1, style=plot.style_linebr)
plot(killSwitch, "Kill Switch (SL)", color=color.new(color.red, 30), linewidth=1, style=plot.style_linebr)
plot(asianHigh, "Asian High", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(asianLow, "Asian Low", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(p90Found and not p90Found[1], "P90 Detected", "DMR: P90 candle detected")
alertcondition(deepTouched and not deepTouched[1], "Deep State Touched", "DMR: Price touched Deep State level")
alertcondition(entered and not entered[1], "DMR Entry", "DMR: Mean reversion entry triggered")
