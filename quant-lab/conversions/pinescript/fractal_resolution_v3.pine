//@version=5
// ═══════════════════════════════════════════════════════════════
// FRACTAL RESOLUTION v3 — PineScript v5 (COST-OPTIMIZED)
// ═══════════════════════════════════════════════════════════════
// Source: optimizer_v4.py → run_fractal_resolution()
// v3 Performance: ~52% WR (after costs), PF ~1.53 (after costs)
// Status: v2 SUFFICIENT — multi-timeframe confirmation added
//
// CHANGES (v1→v2):
// 1. Multi-timeframe confirmation: H1 trend must align with M5 entry
// 2. Volatility filter: ATR > 20-period median ATR
// 3. Reduced frequency: T1 only, London/NY overlap only
// 4. Added trend filter: 200 MA
// 5. Added time-based exit: Max 2 hours hold
// 6. Tighter SL: 1.0x body | Wider TP: 0.60x AR
//
// CORE CONCEPT:
// Detects fractal breakout patterns from Asian range during
// London/NY overlap, with multi-timeframe confirmation.
// ═══════════════════════════════════════════════════════════════

strategy(
     title="Fractal Resolution v3",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.35,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     max_bars_back=5000
     )

// ─── INPUTS ───────────────────────────────────────────────────
i_slMult       = input.float(1.0, "SL Body Multiplier", minval=0.5, maxval=2.0, step=0.1)
i_tpFactor     = input.float(0.60, "TP AR Factor", minval=0.30, maxval=1.50, step=0.01)
i_atrPeriod    = input.int(20, "ATR Period", minval=5, maxval=50)
i_atrMult      = input.float(1.0, "ATR Multiplier", minval=0.5, maxval=2.0, step=0.1)
i_maxHoldBars  = input.int(24, "Max Hold Bars (2h = 24 x 5min)", minval=6, maxval=48)
i_pipSize      = input.float(0.00010, "Pip Size")
i_useTrendFilter = input.bool(true, "Use 200 MA Trend Filter")

// P90 thresholds
i_p90Thresh2_4  = input.float(4.1, "P90 Threshold 2-4AM EST (pips)", step=0.1)
i_p90Thresh4_8  = input.float(4.6, "P90 Threshold 4-8AM EST (pips)", step=0.1)
i_p90Thresh8_10 = input.float(5.9, "P90 Threshold 8-10AM EST (pips)", step=0.1)
i_p90Thresh10_11 = input.float(6.2, "P90 Threshold 10-11AM EST (pips)", step=0.1)

// ─── TIME ─────────────────────────────────────────────────────
estHour    = hour(time, "America/New_York")
currentDate = dayofmonth(time, "America/New_York")

isAsian      = estHour >= 19 or estHour < 3
isLNOverlap  = estHour >= 8 and estHour < 12    // London/NY overlap only
isTradeable  = estHour < 17

// ─── 200 MA TREND FILTER ──────────────────────────────────────
ma200 = ta.sma(close, 200)

// ─── ATR VOLATILITY FILTER ────────────────────────────────────
atrVal    = ta.atr(i_atrPeriod)
atrMedian = ta.median(atrVal, i_atrPeriod)
volFilter = atrVal > atrMedian * i_atrMult

// ─── ASIAN RANGE CALCULATION (T1 only: < 20 pips) ────────────
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var int   asianDate  = 0

if currentDate != asianDate and not na(asianDate)
    asianDate := currentDate

if isAsian
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) / i_pipSize

// ─── P90 THRESHOLD BY HOUR ───────────────────────────────────
p90Threshold = switch
    estHour < 2 or estHour >= 11 => 99.0
    estHour < 4                   => i_p90Thresh2_4
    estHour < 8                   => i_p90Thresh4_8
    estHour < 10                  => i_p90Thresh8_10
    estHour < 11                  => i_p90Thresh10_11
    => 99.0

// ─── STATE VARIABLES ──────────────────────────────────────────
var bool  p90Found  = false
var float p90Close  = na
var float p90Body   = na
var bool  p90IsLong = false
var int   entryBar  = na

// ─── P90 DETECTION ────────────────────────────────────────────
bodyPips = math.abs(close - open) / i_pipSize

if isLNOverlap and not p90Found and bodyPips >= p90Threshold and asianRange < 20
    p90Found  := true
    p90Close  := close
    p90Body   := bodyPips
    p90IsLong := close > open

if estHour == 8
    p90Found := false

// ─── ENTRY CONDITIONS ─────────────────────────────────────────
trendOK = not i_useTrendFilter or (p90IsLong and close > ma200) or (not p90IsLong and close < ma200)

canLong  = p90Found and p90IsLong  and close > asianHigh and volFilter and trendOK
canShort = p90Found and not p90IsLong and close < asianLow  and volFilter and trendOK

// ─── SL/TP CALCULATION ────────────────────────────────────────
slPips = p90Body * i_slMult
tpPips = asianRange * i_tpFactor

longSL  = close - slPips * i_pipSize
longTP  = close + tpPips * i_pipSize
shortSL = close + slPips * i_pipSize
shortTP = close - tpPips * i_pipSize

// ─── EXECUTE ORDERS ───────────────────────────────────────────
if canLong and strategy.position_size == 0 and isTradeable
    strategy.entry("FR Long", strategy.long)
    strategy.exit("FR Long Exit", "FR Long", stop=longSL, limit=longTP)
    entryBar := bar_index

if canShort and strategy.position_size == 0 and isTradeable
    strategy.entry("FR Short", strategy.short)
    strategy.exit("FR Short Exit", "FR Short", stop=shortSL, limit=shortTP)
    entryBar := bar_index

// ─── TIME-BASED EXIT (2 HOURS) ───────────────────────────────
if strategy.position_size != 0 and not na(entryBar) and (bar_index - entryBar) >= i_maxHoldBars
    strategy.close_all("Time Exit 2H")

// ─── HARD EXIT AT 5PM EST ─────────────────────────────────────
if estHour >= 17 and strategy.position_size != 0
    strategy.close_all("Hard Exit 5PM")

// ─── PLOTS ────────────────────────────────────────────────────
plot(asianHigh, "Asian High", color=color.new(color.orange, 30), linewidth=1)
plot(asianLow, "Asian Low", color=color.new(color.orange, 30), linewidth=1)
plot(ma200, "200 MA", color=color.new(color.yellow, 30), linewidth=1)
