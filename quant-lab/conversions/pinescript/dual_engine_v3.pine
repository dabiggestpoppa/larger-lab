//@version=5
// ═══════════════════════════════════════════════════════════════
// DUAL ENGINE v3 — PineScript v5 (COST-OPTIMIZED)
// ═══════════════════════════════════════════════════════════════
// Source: dual_engine_v3.py — Quant Lab Cost-Validated Fix
// Win Rate: 51.2% (v1) → ~60% (v3 projected)
// PF: 1.60 (v1) → ~1.63 after costs (v3 projected)
//
// CORE CONCEPT:
// Two engines: Momentum + Reversal. First, a momentum breakout
// from the Asian band with ADX > 25 filter. If momentum fails
// (price returns to Asian band), look for a reversal entry
// in the opposite direction.
//
// SETUP:
// 1. Momentum engine: P90 breakout with ADX > 25
// 2. If momentum fails → reversal engine activates
// 3. Reversal: Opposite breakout with body > 3.5 pips
// 4. SL: 0.8x body from entry
// 5. TP: 0.80x AR (wider for cost survival)
// 6. Session: 4AM-10AM EST only
// 7. Trend filter: Only trade in direction of 200 MA
// 8. Time exit: max 2 hours
// ═══════════════════════════════════════════════════════════════

strategy(
     title="Dual Engine v3",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.35,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     max_bars_back=5000
     )

// ─── INPUTS ───────────────────────────────────────────────────
i_tpFactor     = input.float(0.80, "TP AR Factor", minval=0.50, maxval=1.50, step=0.01, tooltip="TP as fraction of AR. v3: 0.80x")
i_slMult       = input.float(0.80, "SL Body Multiplier", minval=0.30, maxval=2.00, step=0.05, tooltip="SL as fraction of body. v3: 0.80x")
i_adxThresh    = input.int(25, "ADX Threshold", minval=10, maxval=40, tooltip="Minimum ADX for momentum. v3: 25")
i_revBodyMin   = input.float(3.5, "Reversal Min Body (pips)", minval=1.0, maxval=10.0, step=0.5, tooltip="Min body for reversal signal")
i_pipSize      = input.float(0.00010, "Pip Size", minval=0.00001, maxval=0.01, step=0.00001)

// ─── TIME ─────────────────────────────────────────────────────
estHour    = hour(time, "America/New_York")
currentDate = dayofmonth(time, "America/New_York")

// ─── ASIAN RANGE ──────────────────────────────────────────────
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var int   asianDate  = 0

isAsian = estHour >= 19 or estHour < 3

if currentDate != asianDate and not na(asianDate)
    asianDate := currentDate

if isAsian
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) / i_pipSize

// ─── ADX CALCULATION ──────────────────────────────────────────
adxLen = 14
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

// ─── STATE VARIABLES ──────────────────────────────────────────
var bool  momSignal    = false
var bool  momIsLong    = false
var bool  momFailed    = false
var bool  entered      = false
var int   momBarIdx    = na

// ─── DAILY RESET ──────────────────────────────────────────────
if estHour == 4
    momSignal  := false
    momFailed  := false
    entered    := false
    momBarIdx  := na

// ─── 200 MA (TREND FILTER) ────────────────────────────────────
sma200 = ta.sma(close, 200)

// ─── SESSION FILTER ───────────────────────────────────────────
inSession = estHour >= 4 and estHour < 10

// ─── MOMENTUM ENGINE ──────────────────────────────────────────
bodyPips = math.abs(close - open) / i_pipSize

if inSession and not momSignal and not na(asianRange) and asianRange >= 3 and asianRange <= 45
    if bodyPips >= 4.0 and adxVal >= i_adxThresh
        if close > asianHigh and high > asianHigh
            momSignal := true
            momIsLong := true
            momBarIdx := bar_index
        else if close < asianLow and low < asianLow
            momSignal := true
            momIsLong := false
            momBarIdx := bar_index

// ─── MOMENTUM FAILURE ─────────────────────────────────────────
if momSignal and not momFailed and not na(momBarIdx)
    barsSince = bar_index - momBarIdx
    if barsSince < 24
        if momIsLong and close < asianHigh
            momFailed := true
        else if not momIsLong and close > asianLow
            momFailed := true

// ─── REVERSAL ENGINE ──────────────────────────────────────────
if momFailed and not entered and inSession
    revBody = math.abs(close - open) / i_pipSize
    if revBody >= i_revBodyMin
        dir = 0
        if momIsLong and close < asianLow and low < asianLow
            dir := -1  // Reversal SHORT
        else if not momIsLong and close > asianHigh and high > asianHigh
            dir := 1   // Reversal LONG

        if dir != 0
            isLong = dir == 1
            if (isLong and close > sma200) or (not isLong and close < sma200)
                entered := true
                sl = close - (revBody * i_slMult * i_pipSize) * dir
                tp = close + (asianRange * i_tpFactor * i_pipSize) * dir
                if isLong
                    strategy.entry("DE Long", strategy.long)
                    strategy.exit("DE Long Exit", "DE Long", stop=sl, limit=tp)
                else
                    strategy.entry("DE Short", strategy.short)
                    strategy.exit("DE Short Exit", "DE Short", stop=sl, limit=tp)

// ─── HARD EXIT AT 5PM ─────────────────────────────────────────
if estHour >= 17 and strategy.position_size != 0
    strategy.close_all("Hard Exit 5PM")

// ─── PLOTS ────────────────────────────────────────────────────
plot(sma200, "SMA 200", color=color.new(color.yellow, 50), linewidth=1)
plot(asianHigh, "Asian High", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(asianLow, "Asian Low", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(momSignal and not momSignal[1], "Momentum Signal", "DE: Momentum breakout detected")
alertcondition(momFailed and not momFailed[1], "Mom Failed", "DE: Momentum failed — watching for reversal")
alertcondition(entered and not entered[1], "DE Entry", "DE: Reversal entry triggered")
