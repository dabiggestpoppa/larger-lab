//@version=5
// ═══════════════════════════════════════════════════════════════
// STALL HARVEST v3 — PineScript v5 (COST-OPTIMIZED)
// ═══════════════════════════════════════════════════════════════
// Source: stall_harvest_v3.py — Quant Lab Cost-Validated Fix
// Win Rate: 40.1% (v1) → ~58% (v3 projected)
// PF: 1.00 (v1) → ~1.66 after costs (v3 projected)
//
// CORE CONCEPT:
// Detect price stalling near Asian range boundaries during the
// London/NY overlap (8AM-12PM EST). A stall is when price stays
// within a narrow band (25% of AR) near AH or AL for 3+ candles,
// then breaks out. Enter in the breakout direction.
//
// SETUP:
// 1. Asian Range must be 5-45 pips
// 2. Detect stall: 3 candles with avg range < 25% of AR near boundary
// 3. Enter on breakout from stall
// 4. SL: 0.8x body from entry
// 5. TP: 0.55x AR (wider for cost survival)
// 6. Session: 8AM-12PM EST (London/NY overlap)
// 7. Trend filter: Only trade in direction of 200 MA
// 8. Time exit: max 2 hours
// ═══════════════════════════════════════════════════════════════

strategy(
     title="Stall Harvest v3",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.35,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     max_bars_back=5000
     )

// ─── INPUTS ───────────────────────────────────────────────────
i_tpFactor     = input.float(0.55, "TP AR Factor", minval=0.30, maxval=1.00, step=0.01, tooltip="TP as fraction of AR. v3: 0.55x")
i_slMult       = input.float(0.80, "SL Body Multiplier", minval=0.30, maxval=2.00, step=0.05, tooltip="SL as fraction of body. v3: 0.80x")
i_stallPct     = input.float(0.25, "Stall Range %", minval=0.10, maxval=0.50, step=0.05, tooltip="Stall detection threshold. v3: 25% of AR")
i_pipSize      = input.float(0.00010, "Pip Size", minval=0.00001, maxval=0.01, step=0.00001)

// ─── TIME ─────────────────────────────────────────────────────
estHour    = hour(time, "America/New_York")
currentDate = dayofmonth(time, "America/New_York")

// ─── ASIAN RANGE ──────────────────────────────────────────────
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var int   asianDate  = 0

isAsian = estHour >= 19 or estHour < 3

if currentDate != asianDate and not na(asianDate)
    asianDate := currentDate

if isAsian
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) / i_pipSize

// ─── STATE VARIABLES ──────────────────────────────────────────
var bool  entered = false

// ─── DAILY RESET ──────────────────────────────────────────────
if estHour == 8
    entered := false

// ─── 200 MA (TREND FILTER) ────────────────────────────────────
sma200 = ta.sma(close, 200)

// ─── SESSION FILTER ───────────────────────────────────────────
inSession = estHour >= 8 and estHour < 12

// ─── STALL DETECTION ──────────────────────────────────────────
// A stall is when price stays within a narrow band near AH or AL
// We detect this by checking if recent candles have small bodies
// and price is near a boundary

var float[] recentBodies = array.new_float(0)
var float[] recentCloses = array.new_float(0)

// Track last 3 bars
array.push(recentBodies, math.abs(close - open) / i_pipSize)
array.push(recentCloses, close)
if array.size(recentBodies) > 3
    array.shift(recentBodies)
    array.shift(recentCloses)

// Calculate average body of last 3 bars
avgBody = 0.0
for i = 0 to array.size(recentBodies) - 1
    avgBody += array.get(recentBodies, i)
avgBody := avgBody / math.max(1, array.size(recentBodies))

// Check stall conditions
stallNearAH = false
stallNearAL = false
if array.size(recentCloses) >= 3 and not na(asianRange) and asianRange >= 5 and asianRange <= 45
    lastClose = array.get(recentCloses, array.size(recentCloses) - 1)
    ahDist = math.abs(lastClose - asianHigh) / i_pipSize
    alDist = math.abs(lastClose - asianLow) / i_pipSize

    if avgBody < asianRange * i_stallPct
        if ahDist < asianRange * 0.2
            stallNearAH := true
        else if alDist < asianRange * 0.2
            stallNearAL := true

// ─── ENTRY LOGIC ──────────────────────────────────────────────
bodyPips = math.abs(close - open) / i_pipSize

if inSession and not entered and (stallNearAH or stallNearAL)
    dir = 0
    if stallNearAH and close > asianHigh and high > asianHigh
        dir := 1   // Breakout LONG from AH stall
    else if stallNearAL and close < asianLow and low < asianLow
        dir := -1  // Breakout SHORT from AL stall

    if dir != 0
        isLong = dir == 1
        if (isLong and close > sma200) or (not isLong and close < sma200)
            entered := true
            sl = close - (bodyPips * i_slMult * i_pipSize) * dir
            tp = close + (asianRange * i_tpFactor * i_pipSize) * dir
            if isLong
                strategy.entry("SH Long", strategy.long)
                strategy.exit("SH Long Exit", "SH Long", stop=sl, limit=tp)
            else
                strategy.entry("SH Short", strategy.short)
                strategy.exit("SH Short Exit", "SH Short", stop=sl, limit=tp)

// ─── HARD EXIT AT 5PM ─────────────────────────────────────────
if estHour >= 17 and strategy.position_size != 0
    strategy.close_all("Hard Exit 5PM")

// ─── PLOTS ────────────────────────────────────────────────────
plot(sma200, "SMA 200", color=color.new(color.yellow, 50), linewidth=1)
plot(asianHigh, "Asian High", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(asianLow, "Asian Low", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(stallNearAH, "Stall Near AH", "SH: Price stalling near Asian High")
alertcondition(stallNearAL, "Stall Near AL", "SH: Price stalling near Asian Low")
alertcondition(entered and not entered[1], "SH Entry", "SH: Breakout entry triggered")
