//@version=5
// ═══════════════════════════════════════════════════════════════
// CONSTRAINT ANCHOR v3 — PineScript v5 (COST-OPTIMIZED)
// ═══════════════════════════════════════════════════════════════
// Source: constraint_anchor_v3.py — Quant Lab Cost-Validated Fix
// Win Rate: 36.2% (v1) → ~54% (v3 projected)
// PF: 0.90 (v1) → ~1.55 after costs (v3 projected)
//
// CORE CONCEPT:
// Inverted constraint logic — instead of entering when AR is near
// constraints (too wide or too narrow), enter when AR is in the
// optimal sweet spot (10-15 pips). Trade during London/NY overlap
// with trend filter.
//
// SETUP:
// 1. Asian Range must be in sweet spot: 10-15 pips
// 2. P90 candle with body >= threshold for that hour
// 3. Close must be 2+ pips beyond Asian band
// 4. Session: 8AM-12PM EST (London/NY overlap)
// 5. Trend filter: Only trade in direction of 200 MA
// 6. SL: 1.5x body from entry
// 7. TP: 0.70x AR (wider for cost survival)
// 8. Time exit: max 2 hours
// ═══════════════════════════════════════════════════════════════

strategy(
     title="Constraint Anchor v3",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.35,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     max_bars_back=5000
     )

// ─── INPUTS ───────────────────────────────────────────────────
i_tpFactor     = input.float(0.70, "TP AR Factor", minval=0.40, maxval=1.20, step=0.01, tooltip="TP as fraction of AR. v3: 0.70x")
i_slMult       = input.float(1.50, "SL Body Multiplier", minval=0.50, maxval=3.00, step=0.05, tooltip="SL as fraction of body. v3: 1.50x")
i_arMin        = input.int(10, "AR Sweet Spot Min (pips)", minval=5, maxval=20, tooltip="Minimum AR for sweet spot")
i_arMax        = input.int(15, "AR Sweet Spot Max (pips)", minval=10, maxval=30, tooltip="Maximum AR for sweet spot")
i_closeDist    = input.float(2.0, "Min Close Distance (pips)", minval=0.5, maxval=5.0, step=0.5, tooltip="Close must be this far beyond band")
i_pipSize      = input.float(0.00010, "Pip Size", minval=0.00001, maxval=0.01, step=0.00001)

// ─── TIME ─────────────────────────────────────────────────────
estHour    = hour(time, "America/New_York")
currentDate = dayofmonth(time, "America/New_York")

// ─── ASIAN RANGE ──────────────────────────────────────────────
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var int   asianDate  = 0

isAsian = estHour >= 19 or estHour < 3

if currentDate != asianDate and not na(asianDate)
    asianDate := currentDate

if isAsian
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) / i_pipSize

// ─── P90 THRESHOLDS BY HOUR ───────────────────────────────────
p90Threshold = switch
    estHour < 2 or estHour >= 11 => 99.0
    estHour < 4                   => 4.1
    estHour < 8                   => 4.6
    estHour < 10                  => 5.9
    estHour < 11                  => 6.2
    => 99.0

// ─── STATE VARIABLES ──────────────────────────────────────────
var bool  entered = false

// ─── DAILY RESET ──────────────────────────────────────────────
if estHour == 8
    entered := false

// ─── 200 MA (TREND FILTER) ────────────────────────────────────
sma200 = ta.sma(close, 200)

// ─── SESSION FILTER ───────────────────────────────────────────
inSession = estHour >= 8 and estHour < 12

// ─── AR SWEET SPOT CHECK ──────────────────────────────────────
inSweetSpot = not na(asianRange) and asianRange >= i_arMin and asianRange <= i_arMax

// ─── ENTRY LOGIC ──────────────────────────────────────────────
bodyPips = math.abs(close - open) / i_pipSize

if inSession and not entered and inSweetSpot
    if bodyPips >= p90Threshold
        dir = 0
        if close > asianHigh and high > asianHigh
            closeDist = (close - asianHigh) / i_pipSize
            if closeDist >= i_closeDist
                dir := 1
        else if close < asianLow and low < asianLow
            closeDist = (asianLow - close) / i_pipSize
            if closeDist >= i_closeDist
                dir := -1

        if dir != 0
            isLong = dir == 1
            if (isLong and close > sma200) or (not isLong and close < sma200)
                entered := true
                sl = close - (bodyPips * i_slMult * i_pipSize) * dir
                tp = close + (asianRange * i_tpFactor * i_pipSize) * dir
                if isLong
                    strategy.entry("CA Long", strategy.long)
                    strategy.exit("CA Long Exit", "CA Long", stop=sl, limit=tp)
                else
                    strategy.entry("CA Short", strategy.short)
                    strategy.exit("CA Short Exit", "CA Short", stop=sl, limit=tp)

// ─── HARD EXIT AT 5PM ─────────────────────────────────────────
if estHour >= 17 and strategy.position_size != 0
    strategy.close_all("Hard Exit 5PM")

// ─── PLOTS ────────────────────────────────────────────────────
plot(sma200, "SMA 200", color=color.new(color.yellow, 50), linewidth=1)
plot(asianHigh, "Asian High", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(asianLow, "Asian Low", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(inSweetSpot and inSession, "AR Sweet Spot", "CA: Asian Range in sweet spot — watching for entry")
alertcondition(entered and not entered[1], "CA Entry", "CA: Breakout entry triggered")
