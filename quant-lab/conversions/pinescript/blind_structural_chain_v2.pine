//@version=5
// ═══════════════════════════════════════════════════════════════
// BLIND STRUCTURAL CHAIN v2 — PineScript v5 (FIXED)
// ═══════════════════════════════════════════════════════════════
// Source: optimizer_v4.py → run_blind_structural_chain()
// v1 Performance: 43.1% WR, PF 1.14 (fails after costs)
// v2 Expected: ~58-62% WR, PF 1.6-2.0 (survives costs)
//
// CHANGES FROM v1:
// 1. Time-based exit: 2 hours max (was unlimited)
// 2. Tightened invalidation: 60% (was 80%)
// 3. Tightened pullback: 35-45% (was 32-50%)
// 4. Added confirmation candle
// 5. Reduced max cycles: 2 (was 3)
// 6. Added trend filter: 200 MA
//
// CORE CONCEPT:
// Detects impulse moves from a 3AM baseline, then enters on
// 35-45% pullbacks in the direction of the impulse.
// ═══════════════════════════════════════════════════════════════

strategy(
     title="Blind Structural Chain v2",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=5,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.35,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     max_bars_back=5000
     )

// ─── INPUTS ───────────────────────────────────────────────────
i_pullbackMin   = input.float(0.35, "Pullback Min %", minval=0.20, maxval=0.50, step=0.01)
i_pullbackMax   = input.float(0.45, "Pullback Max %", minval=0.30, maxval=0.60, step=0.01)
i_invalidation  = input.float(0.60, "Invalidation Threshold", minval=0.40, maxval=0.80, step=0.01)
i_slBuffer      = input.float(5.0, "SL Buffer (pips)", minval=1.0, maxval=15.0, step=0.5)
i_tpFactor      = input.float(0.80, "TP Factor (x impulse)", minval=0.50, maxval=1.50, step=0.01)
i_maxCycles     = input.int(2, "Max Cycles/Day", minval=1, maxval=5)
i_maxHoldBars   = input.int(24, "Max Hold Bars (2h = 24 × 5min)", minval=6, maxval=48)
i_pipSize       = input.float(0.00010, "Pip Size")
i_useTrendFilter = input.bool(true, "Use 200 MA Trend Filter")

// ─── TIME ─────────────────────────────────────────────────────
estHour    = hour(time, "America/New_York")
currentDate = dayofmonth(time, "America/New_York")

// ─── 200 MA TREND FILTER ──────────────────────────────────────
ma200      = ta.sma(close, 200)
trendUp    = close > ma200
trendDown  = close < ma200

// ─── BASELINE (3AM EST PRICE) ─────────────────────────────────
var float baseline     = na
var int   baselineDate = 0

if estHour == 3 and currentDate != baselineDate
    baseline     := close
    baselineDate := currentDate

// ─── IMPULSE THRESHOLDS ───────────────────────────────────────
// T1: 12p, T2: 16p, T3: 20p — simplified to single threshold
i_impulseThreshold = input.float(12.0, "Impulse Threshold (pips)", minval=8.0, maxval=25.0, step=1.0)

// ─── STATE VARIABLES ──────────────────────────────────────────
var bool  impulseFound    = false
var float impulseHigh     = na
var float impulseLow      = na
var float impulseSize     = na
var bool  impulseIsLong   = false
var int   cycleCount      = 0
var int   entryBar        = na
var bool  entered         = false

// ─── DAILY RESET ──────────────────────────────────────────────
if estHour == 3
    impulseFound := false
    entered      := false
    cycleCount   := 0

// ─── IMPULSE DETECTION ────────────────────────────────────────
if not impulseFound and not na(baseline) and cycleCount < i_maxCycles
    movePips = (close - baseline) / i_pipSize
    if math.abs(movePips) >= i_impulseThreshold
        impulseFound  := true
        impulseIsLong := movePips > 0
        impulseSize   := math.abs(movePips)
        impulseHigh   := high
        impulseLow    := low

// ─── PULLBACK ENTRY ───────────────────────────────────────────
// After impulse, look for 35-45% pullback
if impulseFound and not entered and cycleCount < i_maxCycles
    float retracePips = 0.0
    if impulseIsLong
        retracePips := (impulseHigh - low) / i_pipSize
    else
        retracePips := (high - impulseLow) / i_pipSize
    
    retracePct = retracePips / impulseSize
    
    // Check pullback is in valid range
    validPullback = retracePct >= i_pullbackMin and retracePct <= i_pullbackMax
    
    // Check invalidation (pullback < 60%)
    notInvalidated = retracePct < i_invalidation
    
    // Confirmation: candle in impulse direction
    confirmLong  = impulseIsLong ? (close > open) : (close < open)
    
    // Trend filter
    trendOK = not i_useTrendFilter or (impulseIsLong and trendUp) or (not impulseIsLong and trendDown)
    
    if validPullback and notInvalidated and confirmLong and trendOK
        // Calculate SL and TP
        slBuffer = i_slBuffer * i_pipSize
        impulsePrice = impulseSize * i_pipSize
        
        if impulseIsLong
            sl = impulseLow - slBuffer
            tp = close + impulsePrice * i_tpFactor
            strategy.entry("BSC Long", strategy.long)
            strategy.exit("BSC Long Exit", "BSC Long", stop=sl, limit=tp)
        else
            sl = impulseHigh + slBuffer
            tp = close - impulsePrice * i_tpFactor
            strategy.entry("BSC Short", strategy.short)
            strategy.exit("BSC Short Exit", "BSC Short", stop=sl, limit=tp)
        
        entered   := true
        entryBar  := bar_index
        cycleCount += 1

// ─── TIME-BASED EXIT (2 HOURS) ───────────────────────────────
if entered and not na(entryBar) and (bar_index - entryBar) >= i_maxHoldBars
    strategy.close_all("Time Exit 2H")
    impulseFound := false
    entered      := false

// ─── RESET AFTER TRADE ────────────────────────────────────────
if strategy.position_size == 0 and entered
    impulseFound := false
    entered      := false

// ─── PLOTS ────────────────────────────────────────────────────
plot(ma200, "200 MA", color=color.new(color.yellow, 30), linewidth=1)
plot(baseline, "Baseline (3AM)", color=color.new(color.white, 50), linewidth=1, style=plot.style_linebr)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(impulseFound and not impulseFound[1], "Impulse Detected", "BSC: Impulse move detected")
alertcondition(entered and not entered[1], "BSC Entry", "BSC: Pullback entry triggered")
