//@version=6
strategy("CEREBUS DMR HYBRID v7",
 overlay=true,
 default_qty_type=strategy.percent_of_equity,
 default_qty_value=5,
 commission_type=strategy.commission.cash_per_order,
 commission_value=0.0,
 slippage=0,
 pyramiding=0,
 max_labels_count=500,
 calc_on_every_tick=true,
 process_orders_on_close=false)

// ============================================================================
// ⚙️ GLOBAL SETTINGS
// ============================================================================

enable_p90     = input.bool(true, "🔷 Enable P90 System (filters only, no momentum entry)")
enable_dmr     = input.bool(true, "🔶 Enable DMR Mean Reversion (only entry)")
alert_on       = input.bool(true, "Enable Alerts")
session_filter = input.bool(true, "Only Trade Prime Hours (2 AM - 12 PM EST)?")
max_drawdown_pct = input.float(3.0, "Max Daily Drawdown %")

// ============================================================================
// 📊 ASIAN RANGE P90 SETTINGS [EST TIMES]
// ============================================================================

asian_start_hour_est = input.int(19, "【P90】Asian Range Start Hour (EST)", minval=0, maxval=23, group="Asian Range P90")
asian_end_hour_est   = input.int(3,  "【P90】Asian Range End Hour (EST)", minval=0, maxval=23, group="Asian Range P90")
entry_start_hour_est = input.int(2,  "【P90】Entry Start Hour (EST)", minval=0, maxval=23, group="Asian Range P90")
entry_end_hour_est   = input.int(11, "【P90】Entry End Hour (EST)", minval=0, maxval=23, group="Asian Range P90")

ar_go_threshold      = input.int(30, "【P90】Asian Range GO Threshold (pips)", minval=10, group="Asian Range P90")
ar_caution_threshold = input.int(45, "【P90】Asian Range CAUTION Threshold (pips)", minval=30, group="Asian Range P90")
ar_nogo_threshold    = input.int(55, "【P90】Asian Range NO-GO Threshold (pips)", minval=45, group="Asian Range P90")

p90_bull_2_4am   = input.float(4.1, "【P90 Bull】2-4 AM EST (pips)", group="Asian Range P90")
p90_bull_4_6am   = input.float(4.6, "【P90 Bull】4-6 AM EST (pips)", group="Asian Range P90")
p90_bull_6_8am   = input.float(4.6, "【P90 Bull】6-8 AM EST (pips)", group="Asian Range P90")
p90_bull_8_10am  = input.float(5.9, "【P90 Bull】8-10 AM EST (pips)", group="Asian Range P90")
p90_bull_10_11am = input.float(6.2, "【P90 Bull】10-11 AM EST (pips)", group="Asian Range P90")

p90_bear_2_4am   = input.float(4.1, "【P90 Bear】2-4 AM EST (pips)", group="Asian Range P90")
p90_bear_4_6am   = input.float(4.6, "【P90 Bear】4-6 AM EST (pips)", group="Asian Range P90")
p90_bear_6_8am   = input.float(4.6, "【P90 Bear】6-8 AM EST (pips)", group="Asian Range P90")
p90_bear_8_10am  = input.float(5.9, "【P90 Bear】8-10 AM EST (pips)", group="Asian Range P90")
p90_bear_10_11am = input.float(6.2, "【P90 Bear】10-11 AM EST (pips)", group="Asian Range P90")

// Per-symbol P90 thresholds (matching MT5 config)
symbol_mode = input.string("AUTO", "Symbol Mode", options=["AUTO", "EURUSD", "USDCHF", "CHFJPY", "XAUUSD"], group="Per-Symbol Thresholds")

// USDCHF thresholds (from MT5 config — can use EURUSD)
p90_uc_bull_2_4am   = input.float(4.1, "USDCHF Bull 2-4 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bull_4_6am   = input.float(4.6, "USDCHF Bull 4-6 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bull_6_8am   = input.float(4.6, "USDCHF Bull 6-8 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bull_8_10am  = input.float(5.9, "USDCHF Bull 8-10 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bull_10_11am = input.float(6.2, "USDCHF Bull 10-11 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bear_2_4am   = input.float(4.1, "USDCHF Bear 2-4 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bear_4_6am   = input.float(4.6, "USDCHF Bear 4-6 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bear_6_8am   = input.float(4.6, "USDCHF Bear 6-8 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bear_8_10am  = input.float(5.9, "USDCHF Bear 8-10 AM (pips)", group="Per-Symbol Thresholds")
p90_uc_bear_10_11am = input.float(6.2, "USDCHF Bear 10-11 AM (pips)", group="Per-Symbol Thresholds")

// CHFJPY thresholds (from MT5 config)
p90_cj_bull_2_4am   = input.float(5.2, "CHFJPY Bull 2-4 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bull_4_6am   = input.float(8.6, "CHFJPY Bull 4-6 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bull_6_8am   = input.float(8.6, "CHFJPY Bull 6-8 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bull_8_10am  = input.float(7.2, "CHFJPY Bull 8-10 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bull_10_11am = input.float(9.2, "CHFJPY Bull 10-11 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bear_2_4am   = input.float(5.2, "CHFJPY Bear 2-4 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bear_4_6am   = input.float(8.6, "CHFJPY Bear 4-6 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bear_6_8am   = input.float(8.6, "CHFJPY Bear 6-8 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bear_8_10am  = input.float(7.2, "CHFJPY Bear 8-10 AM (pips)", group="Per-Symbol Thresholds")
p90_cj_bear_10_11am = input.float(9.2, "CHFJPY Bear 10-11 AM (pips)", group="Per-Symbol Thresholds")

// XAUUSD thresholds (from MT5 config — in pips where 1 pip = 0.01)
p90_xau_bull_2_4am   = input.float(15.0, "XAUUSD Bull 2-4 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bull_4_6am   = input.float(18.0, "XAUUSD Bull 4-6 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bull_6_8am   = input.float(18.0, "XAUUSD Bull 6-8 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bull_8_10am  = input.float(22.0, "XAUUSD Bull 8-10 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bull_10_11am = input.float(25.0, "XAUUSD Bull 10-11 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bear_2_4am   = input.float(15.0, "XAUUSD Bear 2-4 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bear_4_6am   = input.float(18.0, "XAUUSD Bear 4-6 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bear_6_8am   = input.float(18.0, "XAUUSD Bear 6-8 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bear_8_10am  = input.float(22.0, "XAUUSD Bear 8-10 AM (pips)", group="Per-Symbol Thresholds")
p90_xau_bear_10_11am = input.float(25.0, "XAUUSD Bear 10-11 AM (pips)", group="Per-Symbol Thresholds")

ext_25 = input.float(0.25, "【P90】Extension -25% Level", group="Asian Range P90")
ext_50 = input.float(0.50, "【P90】Extension -50% Level (Primary)", group="Asian Range P90")

sl_80fib_mult = input.float(0.80, "【P90】Position 1 SL - 80% Fib Multiplier", group="Asian Range P90")
sl_1_5x_mult  = input.float(1.50, "【P90】Position 2 SL - 1.5x Candle Multiplier", group="Asian Range P90")
hold_time_minutes  = input.int(120, "【P90】Hold Time (minutes)", group="Asian Range P90")
hard_exit_hour_est = input.int(12, "【P90】Hard Exit Hour (EST) - 12 PM EST", group="Asian Range P90")

pos1_size = input.float(40, "【P90】Position 1 Size (%)", minval=10, maxval=50, group="Asian Range P90")
pos2_size = input.float(40, "【P90】Position 2 Size (%)", minval=10, maxval=50, group="Asian Range P90")
pos3_size = input.float(20, "【P90】Position 3 Size (%)", minval=10, maxval=30, group="Asian Range P90")

add_time_minutes    = input.int(45, "【P90】Add Position Time (minutes)", group="Asian Range P90")
add_extension_pips  = input.float(8.0, "【P90】Add Position Extension Required (pips)", group="Asian Range P90")
violation_mult      = input.float(1.32, "【P90】132% Violation Multiplier", group="Asian Range P90")

// ============================================================================
// 📊 DMR SETTINGS
// ============================================================================

dmr_deep_mult  = input.float(2.00, "【DMR】Deep State Multiplier", minval=1.50, maxval=3.00, step=0.01, group="DMR Mean Reversion")
dmr_kill_mult  = input.float(2.20, "【DMR】Kill Switch Multiplier", minval=1.80, maxval=3.00, step=0.01, group="DMR Mean Reversion")
dmr_max_ar     = input.int(45,    "【DMR】Max Asian Range (pips)", minval=20, maxval=60, group="DMR Mean Reversion")
dmr_min_ar     = input.int(3,     "【DMR】Min Asian Range (pips)", minval=1, maxval=15, group="DMR Mean Reversion")
dmr_pip_size   = input.float(0.00010, "【DMR】Pip Size", minval=0.00001, maxval=0.01, step=0.00001, group="DMR Mean Reversion")
show_fib       = input.bool(true, "Show Fib 168%/200% Levels", group="DMR Mean Reversion")
fib_168_mult   = input.float(1.68, "Fib 168% Multiplier", group="DMR Mean Reversion")
fib_200_mult   = input.float(2.00, "Fib 200% Multiplier", group="DMR Mean Reversion")

// ============================================================================
// 🧮 HELPER FUNCTIONS
// ============================================================================

pip_to_price(pips) => pips * 0.0001

get_est_hour() => (hour(time, "UTC") - 5 + 24) % 24
get_est_minute() => minute(time, "UTC")

in_asian_session() =>
    h = get_est_hour()
    (h >= asian_start_hour_est or h < asian_end_hour_est)

in_p90_entry_window() =>
    h = get_est_hour()
    (h >= entry_start_hour_est and h < entry_end_hour_est)

is_hard_exit_time() =>
    h = get_est_hour()
    h >= hard_exit_hour_est

get_p90_bull_threshold() =>
    h = get_est_hour()
    if h >= 2 and h < 4
        p90_bull_2_4am
    else if h >= 4 and h < 6
        p90_bull_4_6am
    else if h >= 6 and h < 8
        p90_bull_6_8am
    else if h >= 8 and h < 10
        p90_bull_8_10am
    else if h >= 10 and h < 11
        p90_bull_10_11am
    else
        0.0

get_p90_bear_threshold() =>
    h = get_est_hour()
    if h >= 2 and h < 4
        p90_bear_2_4am
    else if h >= 4 and h < 6
        p90_bear_4_6am
    else if h >= 6 and h < 8
        p90_bear_6_8am
    else if h >= 8 and h < 10
        p90_bear_8_10am
    else if h >= 10 and h < 11
        p90_bear_10_11am
    else
        0.0

calc_qty(size_percent, entry_price) =>
    (strategy.equity * size_percent / 100) / entry_price

// ===========================================================================
// 🔍 AUTO SYMBOL DETECTION + PER-SYMBOL THRESHOLDS
// ===========================================================================

ticker_upper = str.upper(syminfo.ticker)
is_eurUSD = str.contains(ticker_upper, "EURUSD") or str.contains(ticker_upper, "EUR/USD")
is_usdCHF = str.contains(ticker_upper, "USDCHF") or str.contains(ticker_upper, "USD/CHF")
is_chfJPY = str.contains(ticker_upper, "CHFJPY") or str.contains(ticker_upper, "CHF/JPY")
is_xauUSD = str.contains(ticker_upper, "XAUUSD") or str.contains(ticker_upper, "XAU/USD") or str.contains(ticker_upper, "GOLD")

active_symbol = symbol_mode == "AUTO" ? (is_xauUSD ? "XAUUSD" : is_chfJPY ? "CHFJPY" : is_usdCHF ? "USDCHF" : "EURUSD") : symbol_mode

pip_divisor = active_symbol == "XAUUSD" ? 0.01 : 0.0001

get_p90_bull_threshold_symbol() =>
    h = get_est_hour()
    if active_symbol == "USDCHF"
        if h >= 2 and h < 4
            p90_uc_bull_2_4am
        else if h >= 4 and h < 6
            p90_uc_bull_4_6am
        else if h >= 6 and h < 8
            p90_uc_bull_6_8am
        else if h >= 8 and h < 10
            p90_uc_bull_8_10am
        else if h >= 10 and h < 11
            p90_uc_bull_10_11am
        else
            99.0
    else if active_symbol == "CHFJPY"
        if h >= 2 and h < 4
            p90_cj_bull_2_4am
        else if h >= 4 and h < 6
            p90_cj_bull_4_6am
        else if h >= 6 and h < 8
            p90_cj_bull_6_8am
        else if h >= 8 and h < 10
            p90_cj_bull_8_10am
        else if h >= 10 and h < 11
            p90_cj_bull_10_11am
        else
            99.0
    else if active_symbol == "XAUUSD"
        if h >= 2 and h < 4
            p90_xau_bull_2_4am
        else if h >= 4 and h < 6
            p90_xau_bull_4_6am
        else if h >= 6 and h < 8
            p90_xau_bull_6_8am
        else if h >= 8 and h < 10
            p90_xau_bull_8_10am
        else if h >= 10 and h < 11
            p90_xau_bull_10_11am
        else
            999.0
    else  // EURUSD (default)
        if h >= 2 and h < 4
            p90_bull_2_4am
        else if h >= 4 and h < 6
            p90_bull_4_6am
        else if h >= 6 and h < 8
            p90_bull_6_8am
        else if h >= 8 and h < 10
            p90_bull_8_10am
        else if h >= 10 and h < 11
            p90_bull_10_11am
        else
            99.0

get_p90_bear_threshold_symbol() =>
    h = get_est_hour()
    if active_symbol == "USDCHF"
        if h >= 2 and h < 4
            p90_uc_bear_2_4am
        else if h >= 4 and h < 6
            p90_uc_bear_4_6am
        else if h >= 6 and h < 8
            p90_uc_bear_6_8am
        else if h >= 8 and h < 10
            p90_uc_bear_8_10am
        else if h >= 10 and h < 11
            p90_uc_bear_10_11am
        else
            99.0
    else if active_symbol == "CHFJPY"
        if h >= 2 and h < 4
            p90_cj_bear_2_4am
        else if h >= 4 and h < 6
            p90_cj_bear_4_6am
        else if h >= 6 and h < 8
            p90_cj_bear_6_8am
        else if h >= 8 and h < 10
            p90_cj_bear_8_10am
        else if h >= 10 and h < 11
            p90_cj_bear_10_11am
        else
            99.0
    else if active_symbol == "XAUUSD"
        if h >= 2 and h < 4
            p90_xau_bear_2_4am
        else if h >= 4 and h < 6
            p90_xau_bear_4_6am
        else if h >= 6 and h < 8
            p90_xau_bear_6_8am
        else if h >= 8 and h < 10
            p90_xau_bear_8_10am
        else if h >= 10 and h < 11
            p90_xau_bear_10_11am
        else
            999.0
    else  // EURUSD (default)
        if h >= 2 and h < 4
            p90_bear_2_4am
        else if h >= 4 and h < 6
            p90_bear_4_6am
        else if h >= 6 and h < 8
            p90_bear_6_8am
        else if h >= 8 and h < 10
            p90_bear_8_10am
        else if h >= 10 and h < 11
            p90_bear_10_11am
        else
            99.0

// ============================================================================
// 🛡️ SHARED DAILY DRAWDOWN PROTECTION
// ============================================================================

var float day_equity_start = na
new_day = ta.change(time("D"))
if new_day != 0
    day_equity_start := strategy.equity

drawdown_today = 100 * (strategy.equity - day_equity_start) / day_equity_start
drawdown_triggered = drawdown_today < -max_drawdown_pct

can_trade_shared = session_filter ? (get_est_hour() >= 2 and get_est_hour() < 12) : true
allow_trade_shared = can_trade_shared and not drawdown_triggered

// ============================================================================
// 📊 ASIAN RANGE CALCULATION
// ============================================================================

var float asian_high = na
var float asian_low = na
var bool  asian_range_complete = false
var int   asian_range_day = na
var int   asian_open_bar = na
var int   asian_close_bar = na

if get_est_hour() == asian_start_hour_est and get_est_minute() == 0
    asian_high := high
    asian_low := low
    asian_open_bar := bar_index
    asian_range_complete := false
    asian_range_day := dayofmonth

if in_asian_session() and not asian_range_complete
    asian_high := math.max(asian_high, high)
    asian_low := math.min(asian_low, low)

if get_est_hour() == asian_end_hour_est and get_est_minute() == 0
    asian_close_bar := bar_index - 1
    asian_range_complete := true

asian_range_pips = (na(asian_high) or na(asian_low)) ? na : (asian_high - asian_low) / pip_divisor

ext_25_long  = asian_range_complete ? asian_high + (asian_range_pips * ext_25 * pip_divisor) : na
ext_50_long  = asian_range_complete ? asian_high + (asian_range_pips * ext_50 * pip_divisor) : na
ext_25_short = asian_range_complete ? asian_low - (asian_range_pips * ext_25 * pip_divisor) : na
ext_50_short = asian_range_complete ? asian_low - (asian_range_pips * ext_50 * pip_divisor) : na

violation_long  = asian_range_complete ? asian_high + (asian_range_pips * violation_mult * pip_divisor) : na
violation_short = asian_range_complete ? asian_low - (asian_range_pips * violation_mult * pip_divisor) : na

// ============================================================================
// 📊 P90 SIGNAL DETECTION
// ============================================================================

var int   last_signal_time = na
var int   last_entry_time  = na
var float p90_entry_price  = na
var float p90_candle_body  = na
var string p90_direction   = ""
var bool  in_hold_period   = false
var int   signals_today    = 0

var float entry_ext_25_long  = na
var float entry_ext_50_long  = na
var float entry_ext_25_short = na
var float entry_ext_50_short = na
var bool  entry_ext_25_hit   = false
var bool  entry_ext_50_hit   = false
var bool  entry_violation_triggered = false

if get_est_hour() == 0 and get_est_minute() == 0
    signals_today    := 0
    last_signal_time := na
    last_entry_time  := na

candle_body_pips = math.abs(close - open) / pip_divisor

p90_bull_threshold = get_p90_bull_threshold_symbol()
p90_bull_candle = close > open and candle_body_pips >= p90_bull_threshold
p90_bull_signal = enable_p90 and in_p90_entry_window() and asian_range_complete and p90_bull_candle and not in_hold_period and allow_trade_shared

p90_bear_threshold = get_p90_bear_threshold_symbol()
p90_bear_candle = close < open and candle_body_pips >= p90_bear_threshold
p90_bear_signal = enable_p90 and in_p90_entry_window() and asian_range_complete and p90_bear_candle and not in_hold_period and allow_trade_shared

if p90_bull_signal or p90_bear_signal
    signals_today    := signals_today + 1
    last_signal_time := time
    p90_entry_price  := close
    p90_candle_body  := candle_body_pips
    p90_direction    := p90_bull_signal ? "LONG" : "SHORT"

    entry_ext_25_long  := asian_high + (asian_range_pips * ext_25 * 0.0001)
    entry_ext_50_long  := asian_high + (asian_range_pips * ext_50 * 0.0001)
    entry_ext_25_short := asian_low - (asian_range_pips * ext_25 * 0.0001)
    entry_ext_50_short := asian_low - (asian_range_pips * ext_50 * 0.0001)
    entry_ext_25_hit   := false
    entry_ext_50_hit   := false
    entry_violation_triggered := false

if p90_bull_signal or p90_bear_signal
    last_entry_time := time
    in_hold_period  := true

bool hold_period_expired = false
if not na(last_entry_time)
    minutes_since_entry = (time - last_entry_time) / 60000
    hold_period_expired := minutes_since_entry >= hold_time_minutes
else
    hold_period_expired := true

if hold_period_expired
    in_hold_period := false

// ============================================================================
// 📊 EXTENSION HIT TRACKING
// ============================================================================

if p90_direction == "LONG" and asian_range_complete
    if not entry_ext_25_hit and high >= entry_ext_25_long
        entry_ext_25_hit := true
    if not entry_ext_50_hit and high >= entry_ext_50_long
        entry_ext_50_hit := true
    if not entry_violation_triggered and high >= violation_long
        entry_violation_triggered := true

if p90_direction == "SHORT" and asian_range_complete
    if not entry_ext_25_hit and low <= entry_ext_25_short
        entry_ext_25_hit := true
    if not entry_ext_50_hit and low <= entry_ext_50_short
        entry_ext_50_hit := true
    if not entry_violation_triggered and low <= violation_short
        entry_violation_triggered := true

// ============================================================================
// 📊 ASIAN RANGE FILTER
// ============================================================================

get_ar_status() =>
    if asian_range_pips < ar_go_threshold
        "GO"
    else if asian_range_pips >= ar_go_threshold and asian_range_pips < ar_caution_threshold
        "GO"
    else if asian_range_pips >= ar_caution_threshold and asian_range_pips < ar_nogo_threshold
        "CAUTION"
    else
        "NO-GO"

ar_status = get_ar_status()
filter_25_50_hit = entry_ext_25_hit and entry_ext_50_hit

valid_p90_entry = (p90_bull_signal or p90_bear_signal) and ar_status != "NO-GO" and not filter_25_50_hit and not entry_violation_triggered

// ============================================================================
// 🔶 DMR MEAN REVERSION LOGIC
// ============================================================================

var bool  dmr_p90_found    = false
var float dmr_activation   = na
var float dmr_p90_body     = na
var bool  dmr_p90_is_long  = false
var float dmr_deep_state   = na
var float dmr_kill_switch  = na
var float dmr_fib_168      = na
var float dmr_fib_200      = na
var bool  dmr_deep_touched = false
var bool  dmr_entered      = false
var int   dmr_touch_bar    = na
var bool  dmr_limit_filled = false

// DMR P90 detection — uses per-symbol thresholds
// Use current Asian range (even if not yet complete) for DMR validation
// This allows entries from 2 AM onwards (before Asian range completes at 3 AM)
dmr_asian_ok = (asian_range_complete or (get_est_hour() >= 19 or get_est_hour() < 3)) and asian_range_pips >= dmr_min_ar and asian_range_pips <= dmr_max_ar
if enable_dmr and in_p90_entry_window() and not dmr_p90_found and dmr_asian_ok
    dmr_body_pips = math.abs(close - open) / pip_divisor
    dmr_bull_thresh = get_p90_bull_threshold_symbol()
    dmr_bear_thresh = get_p90_bear_threshold_symbol()
    
    dmr_bull_candle = close > open and dmr_body_pips >= dmr_bull_thresh
    dmr_bear_candle = close < open and dmr_body_pips >= dmr_bear_thresh
    
    if (dmr_bull_candle or dmr_bear_candle)
        dmr_p90_found   := true
        dmr_activation  := close
        dmr_p90_body    := dmr_body_pips
        dmr_p90_is_long := dmr_bull_candle
        body_price      = dmr_p90_body * pip_divisor
        dmr_deep_state  := dmr_activation + body_price * dmr_deep_mult * (dmr_p90_is_long ? 1 : -1)
        dmr_kill_switch := dmr_activation + body_price * dmr_kill_mult * (dmr_p90_is_long ? 1 : -1)
        deep_dist       = math.abs(dmr_deep_state - dmr_activation)
        dmr_fib_168     := dmr_activation + deep_dist * fib_168_mult * (dmr_p90_is_long ? 1 : -1)
        dmr_fib_200     := dmr_activation + deep_dist * fib_200_mult * (dmr_p90_is_long ? 1 : -1)

// DMR daily reset
if get_est_hour() == 2 and get_est_minute() == 0
    dmr_p90_found    := false
    dmr_deep_touched := false
    dmr_entered      := false

// DMR Deep State touch detection — mark for entry on NEXT bar
if dmr_p90_found and not dmr_deep_touched and get_est_hour() < 12
    if dmr_p90_is_long and low <= dmr_deep_state
        dmr_deep_touched := true
    else if not dmr_p90_is_long and high >= dmr_deep_state
        dmr_deep_touched := true

// Reset DMR state after trade completes (position closed)
// This allows a NEW P90 to be detected and new plots to update
if dmr_entered and strategy.position_size == 0
    dmr_deep_touched := false
    dmr_entered      := false
    dmr_p90_found    := false

// DMR Entry — mean reversion AGAINST P90 direction
// Only enter if P90 filters pass (no violation, extensions not both hit)
dmr_rev_is_long = not dmr_p90_is_long
dmr_can_enter = enable_dmr and dmr_deep_touched and not dmr_entered and strategy.position_size == 0 and get_est_hour() < 17 and not entry_violation_triggered

if dmr_can_enter
    dmr_entered := true
    if dmr_rev_is_long
        strategy.entry("DMR_Long", strategy.long, limit=dmr_deep_state, comment="DMR Mean Rev Long")
        strategy.exit("DMR_Long_Exit", "DMR_Long", stop=dmr_kill_switch, limit=dmr_activation, comment="DMR Long Exit")
    else
        strategy.entry("DMR_Short", strategy.short, limit=dmr_deep_state, comment="DMR Mean Rev Short")
        strategy.exit("DMR_Short_Exit", "DMR_Short", stop=dmr_kill_switch, limit=dmr_activation, comment="DMR Short Exit")

// ============================================================================
// 📊 P90 POSITION ENTRY — REMOVED (MAD: only DMR mean reversion entry)
// ============================================================================
// P90 system now acts as FILTER only — no momentum entries
// DMR mean reversion is the sole entry mechanism below

var bool pos3_entered = false
if get_est_hour() == 0 and get_est_minute() == 0
    pos3_entered := false

// ============================================================================
// 📊 EXIT CONDITIONS
// ============================================================================

if is_hard_exit_time() and enable_p90
    strategy.close_all(comment="P90 Hard Exit (12 PM EST)")

if entry_violation_triggered and enable_p90
    strategy.close_all(comment="P90 132% Violation Exit")

if not na(last_entry_time) and enable_p90
    minutes_held = (time - last_entry_time) / 60000
    if minutes_held >= hold_time_minutes
        strategy.close_all(comment="P90 Hold Time Exit (120 min)")
        last_entry_time := na
        in_hold_period  := false

// DMR hard exit at 5PM
if get_est_hour() >= 17 and strategy.position_size != 0
    strategy.close_all(comment="DMR Hard Exit 5PM")

// ============================================================================
// 🔔 ALERTS
// ============================================================================

if alert_on
    if p90_bull_signal and enable_p90
        alert("🟢 P90 BULL Signal - " + str.tostring(candle_body_pips, "#.##") + " pips", alert.freq_once_per_bar)
    if p90_bear_signal and enable_p90
        alert("🔴 P90 BEAR Signal - " + str.tostring(candle_body_pips, "#.##") + " pips", alert.freq_once_per_bar)
    if dmr_deep_touched and enable_dmr
        alert("🔶 DMR Deep State Touched - Mean Reversion Entry", alert.freq_once_per_bar)
    if entry_violation_triggered and enable_p90
        alert("⚠️ P90 132% Violation - Exit All", alert.freq_once_per_bar)

// ============================================================================
// 📊 VISUALIZATION
// ============================================================================

plot(asian_range_complete ? asian_high : na, "Asian High", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(asian_range_complete ? asian_low : na,  "Asian Low",  color=color.new(color.red, 0),   style=plot.style_linebr, linewidth=2)

plotshape(asian_range_complete and bar_index == asian_open_bar, "Asian Open",  shape.flag, location.top, color=color.new(color.blue, 0),   size=size.small, text="7PM")
plotshape(asian_range_complete and bar_index == asian_close_bar, "Asian Close", shape.flag, location.top, color=color.new(color.orange, 0), size=size.small, text="2:55AM")

plot(asian_range_complete ? entry_ext_25_long  : na, "Ext -25% Long",  color=color.new(color.blue, 30),   style=plot.style_linebr, linewidth=1)
plot(asian_range_complete ? entry_ext_50_long  : na, "Ext -50% Long",  color=color.new(color.blue, 0),    style=plot.style_linebr, linewidth=2)
plot(asian_range_complete ? entry_ext_25_short : na, "Ext -25% Short", color=color.new(color.orange, 30), style=plot.style_linebr, linewidth=1)
plot(asian_range_complete ? entry_ext_50_short : na, "Ext -50% Short", color=color.new(color.orange, 0),  style=plot.style_linebr, linewidth=2)

plot(asian_range_complete ? violation_long  : na, "132% Violation Long",  color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(asian_range_complete ? violation_short : na, "132% Violation Short", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

// DMR levels
plot(dmr_activation,  "DMR Activation (TP)",     color=color.new(color.teal, 30),   linewidth=2, style=plot.style_linebr)
plot(dmr_deep_state,  "DMR Deep State (Entry)",  color=color.new(color.purple, 30), linewidth=2, style=plot.style_linebr)
plot(dmr_kill_switch, "DMR Kill Switch (SL)",    color=color.new(color.red, 30),    linewidth=1, style=plot.style_linebr)
plot(show_fib ? dmr_fib_168 : na, "Fib 168%", color=color.new(color.orange, 40), linewidth=1, style=plot.style_linebr)
plot(show_fib ? dmr_fib_200 : na, "Fib 200%", color=color.new(color.yellow, 40), linewidth=1, style=plot.style_linebr)

plotshape(p90_bull_candle and enable_p90 and in_p90_entry_window(), "P90 Bull", shape.triangleup,   location.belowbar, color=color.new(color.yellow, 0), size=size.normal)
plotshape(p90_bear_candle and enable_p90 and in_p90_entry_window(), "P90 Bear", shape.triangledown, location.abovebar, color=color.new(color.yellow, 0), size=size.normal)

bgcolor(in_p90_entry_window() and enable_p90 ? color.new(color.green, 95) : na)
bgcolor(in_asian_session() and enable_p90 ? color.new(color.blue, 97) : na)
bgcolor(in_hold_period and enable_p90 ? color.new(color.purple, 92) : na)

// ============================================================================
// 📊 INFO PANEL
// ============================================================================

var table info_table = table.new(position.top_right, 2, 24, bgcolor=color.black, border_width=1)

if barstate.islast
    table.cell(info_table, 0, 0,  "CEREBUS DMR HYBRID v7", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 0,  active_symbol,               text_color=color.white, bgcolor=color.gray, text_size=size.small)

    table.cell(info_table, 0, 1,  "Current Time (EST)", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 1,  str.tostring(get_est_hour(), "00") + ":" + str.tostring(get_est_minute(), "00"), text_color=color.white, bgcolor=color.blue, text_size=size.small)

    table.cell(info_table, 0, 2,  "P90 Signals Today", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 2,  str.tostring(signals_today), text_color=color.white, bgcolor=color.green, text_size=size.small)

    table.cell(info_table, 0, 3,  "In Hold Period", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 3,  in_hold_period ? "YES" : "NO", text_color=color.white, bgcolor=in_hold_period ? color.purple : color.green, text_size=size.small)

    table.cell(info_table, 0, 4,  "Asian Range", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 4,  str.tostring(asian_range_pips, "#.##") + " pips", text_color=color.white, bgcolor=ar_status == "GO" ? color.green : ar_status == "CAUTION" ? color.orange : color.red, text_size=size.small)

    table.cell(info_table, 0, 5,  "AR Status", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 5,  ar_status, text_color=color.white, bgcolor=ar_status == "GO" ? color.green : ar_status == "CAUTION" ? color.orange : color.red, text_size=size.small)

    table.cell(info_table, 0, 6,  "P90 Direction", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 6,  p90_direction, text_color=color.white, bgcolor=p90_direction == "LONG" ? color.green : p90_direction == "SHORT" ? color.red : color.gray, text_size=size.small)

    table.cell(info_table, 0, 7,  "── DMR STATUS ──", text_color=color.yellow, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 7,  "", text_color=color.white, bgcolor=color.gray, text_size=size.small)

    table.cell(info_table, 0, 8,  "DMR P90 Found", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 8,  dmr_p90_found ? "YES" : "NO", text_color=color.white, bgcolor=dmr_p90_found ? color.green : color.gray, text_size=size.small)

    table.cell(info_table, 0, 9,  "DMR Deep Touched", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 9,  dmr_deep_touched ? "YES" : "NO", text_color=color.white, bgcolor=dmr_deep_touched ? color.purple : color.gray, text_size=size.small)

    table.cell(info_table, 0, 10, "DMR Entered", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 10, dmr_entered ? "YES" : "NO", text_color=color.white, bgcolor=dmr_entered ? color.green : color.gray, text_size=size.small)

    table.cell(info_table, 0, 11, "Fib 168%", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 11, str.tostring(dmr_fib_168, "#.#####"), text_color=color.orange, bgcolor=color.gray, text_size=size.small)

    table.cell(info_table, 0, 12, "Fib 200%", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 12, str.tostring(dmr_fib_200, "#.#####"), text_color=color.yellow, bgcolor=color.gray, text_size=size.small)

    table.cell(info_table, 0, 13, "DMR Direction", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    dmr_dir_str = dmr_entered ? (dmr_rev_is_long ? "LONG (Rev)" : "SHORT (Rev)") : "N/A"
    table.cell(info_table, 1, 13, dmr_dir_str, text_color=color.white, bgcolor=dmr_entered ? color.teal : color.gray, text_size=size.small)

    table.cell(info_table, 0, 14, "── P90 FILTERS ──", text_color=color.yellow, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 14, "", text_color=color.white, bgcolor=color.gray, text_size=size.small)

    table.cell(info_table, 0, 15, "-25% Hit", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 15, entry_ext_25_hit ? "YES" : "NO", text_color=color.white, bgcolor=entry_ext_25_hit ? color.green : color.gray, text_size=size.small)

    table.cell(info_table, 0, 16, "-50% Hit", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 16, entry_ext_50_hit ? "YES" : "NO", text_color=color.white, bgcolor=entry_ext_50_hit ? color.green : color.gray, text_size=size.small)

    table.cell(info_table, 0, 17, "132% Violation", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 17, entry_violation_triggered ? "YES" : "NO", text_color=color.white, bgcolor=entry_violation_triggered ? color.red : color.green, text_size=size.small)

    table.cell(info_table, 0, 18, "Filter Status", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 18, filter_25_50_hit ? "BLOCKED" : "OK", text_color=color.white, bgcolor=filter_25_50_hit ? color.red : color.green, text_size=size.small)

    table.cell(info_table, 0, 19, "── P90P TRACKER ──", text_color=color.yellow, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 19, "", text_color=color.white, bgcolor=color.gray, text_size=size.small)

    table.cell(info_table, 0, 20, "Position Size", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 20, str.tostring(strategy.position_size, "#.##"), text_color=color.white, bgcolor=strategy.position_size != 0 ? color.green : color.gray, text_size=size.small)

    table.cell(info_table, 0, 21, "Open PnL", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 21, str.tostring(strategy.openprofit, "#.##"), text_color=color.white, bgcolor=strategy.openprofit > 0 ? color.green : strategy.openprofit < 0 ? color.red : color.gray, text_size=size.small)

    table.cell(info_table, 0, 22, "Equity", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(info_table, 1, 22, str.tostring(strategy.equity, "#.##"), text_color=color.white, bgcolor=color.blue, text_size=size.small)

    table.cell(info_table, 0, 23, "Day PnL", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    day_pnl = strategy.equity - day_equity_start
    table.cell(info_table, 1, 21, str.tostring(day_pnl, "#.##"), text_color=color.white, bgcolor=day_pnl > 0 ? color.green : day_pnl < 0 ? color.red : color.gray, text_size=size.small)
