//@version=5
strategy("Blind Structural Chain", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=100000, commission_type=strategy.commission.cash_per_order, commission_value=0.5)

// ═══════════════════════════════════════════════════════════════
// Blind Structural Chain — Quant Lab v4
// Performance: 43.1% WR, +2248p, PF 1.14
//
// Logic: Impulse from baseline → enter on 32-50% pullback.
// Up to 3 cycle repetitions per day.
// ═══════════════════════════════════════════════════════════════

// === INPUTS ===
slBufferPips     = input.float(5.0, "SL Buffer (pips)", minval=1.0)
tpImpulseFactor  = input.float(0.80, "TP Impulse Factor", minval=0.1, step=0.05)
pullbackMin      = input.float(0.32, "Pullback Min %", minval=0.1, step=0.01)
pullbackMax      = input.float(0.50, "Pullback Max %", minval=0.2, step=0.01)
invalidationPct  = input.float(0.80, "Invalidation %", minval=0.5, step=0.05)
maxCycles        = input.int(3, "Max Cycles", minval=1, maxval=5)
pipValue         = input.float(0.0001, "Pip Value")

// === TIME ===
estOffset = -5
utcHour = hour(time, "UTC")
estHour = (utcHour + estOffset + 24) % 24

// === ASIAN RANGE ===
var float asianHigh = na
var float asianLow  = na
var float asianRange = na

isAsianSession = estHour >= 19 or estHour < 3

if isAsianSession and barstate.isconfirmed
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)

if estHour == 3 and barstate.isconfirmed
    asianRange := (asianHigh - asianLow) / pipValue
    asianHigh  := na
    asianLow   := na

// === STATE ===
var int cycleCount = 0
var float baselinePrice = na
var int state = 0  // 0=looking_impulse, 1=looking_pullback
var int impulseDirection = 0
var float impulseSize = na
var float impulseExtreme = na
var float pullbackLow = na
var float pullbackHigh = na
var bool invalidated = false
var int pullbackStartBar = na

// === BASELINE: 3 AM EST ===
if estHour == 3 and barstate.isconfirmed
    baselinePrice := close
    cycleCount := 0
    state := 0

// === IMPULSE DETECTION ===
if state == 0 and estHour >= 3 and estHour < 12 and not na(asianRange) and not na(baselinePrice) and barstate.isconfirmed
    if asianRange >= 3.0 and asianRange <= 45.0
        tier = asianRange < 20 ? "T1" : asianRange < 30 ? "T2" : "T3"
        impulseThresh = tier == "T1" ? 12.0 : tier == "T2" ? 16.0 : 20.0
        
        movePips = (close - baselinePrice) / pipValue
        if math.abs(movePips) >= impulseThresh
            impulseDirection := movePips > 0 ? 1 : -1
            impulseSize := math.abs(movePips)
            impulseExtreme := close
            pullbackLow := low
            pullbackHigh := high
            invalidated := false
            pullbackStartBar := bar_index
            state := 1

// === PULLBACK DETECTION ===
if state == 1 and estHour < 12 and barstate.isconfirmed
    // Update pullback extremes
    if impulseDirection == 1
        pullbackLow := math.min(pullbackLow, low)
        if close > impulseExtreme
            impulseExtreme := close
            impulseSize := (close - baselinePrice) / pipValue
            pullbackLow := low
    else
        pullbackHigh := math.max(pullbackHigh, high)
        if close < impulseExtreme
            impulseExtreme := close
            impulseSize := (baselinePrice - close) / pipValue
            pullbackHigh := high
    
    // Check invalidation (80% pullback)
    if impulseDirection == 1
        impulseRange = (impulseExtreme - baselinePrice) / pipValue
        if impulseRange > 0
            if (impulseExtreme - pullbackLow) / impulseRange / impulseSize * impulseSize > invalidationPct
                invalidated := true
    else
        impulseRange = (baselinePrice - impulseExtreme) / pipValue
        if impulseRange > 0
            if (pullbackHigh - impulseExtreme) / impulseRange / impulseSize * impulseSize > invalidationPct
                invalidated := true
    
    // Check pullback entry
    if not invalidated and impulseSize > 0
        if impulseDirection == 1
            retracePct = (impulseExtreme - pullbackLow) / impulseSize
        else
            retracePct = (pullbackHigh - impulseExtreme) / impulseSize
        
        if retracePct >= pullbackMin and retracePct <= pullbackMax
            // Enter trade
            ep = close
            buffer = slBufferPips * pipValue
            slVal = impulseDirection == 1 ? pullbackLow - buffer : pullbackHigh + buffer
            tpVal = ep + (impulseSize * pipValue * tpImpulseFactor) * impulseDirection
            
            label = "BSC_L_" + str.tostring(cycleCount + 1)
            if impulseDirection == 1
                strategy.entry(label, strategy.long)
                strategy.exit(label + "_exit", label, stop=slVal, limit=tpVal)
            else
                label := "BSC_S_" + str.tostring(cycleCount + 1)
                strategy.entry(label, strategy.short)
                strategy.exit(label + "_exit", label, stop=slVal, limit=tpVal)
            
            cycleCount += 1
            if cycleCount >= maxCycles
                state := 2  // Done for the day
            else
                state := 0  // Look for next impulse
                baselinePrice := close
    
    // Timeout: 90 minutes = 18 M5 bars
    if not na(pullbackStartBar) and bar_index - pullbackStartBar > 18
        state := 0
        invalidated := false

// Reset for new day
if estHour == 3 and barstate.isconfirmed
    cycleCount := 0
    state := 0

// Hard exit at 5 PM EST
if estHour >= 17 and barstate.isconfirmed
    strategy.close_all("Hard Exit")
