# OCE Local Ground environment — EXAMPLE ONLY. Copy to .env and fill in.
# NEVER commit a real .env. These values are local-development placeholders,
# separate from any future cloud or production secrets.
#
#   cp infrastructure/local-ground/compose/examples/oce.env.example infrastructure/local-ground/compose/.env
#
# OCE_RUNTIME_TARGET is the master profile selector (A-003). Defaults to local.

OCE_RUNTIME_TARGET=local

# --- PostgreSQL (authoritative truth) ---
POSTGRES_DB=oce_local
POSTGRES_USER=oce_local_admin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Redis (transient transport only) ---
REDIS_PASSWORD=change-me-local-only

# --- Artifact store (minio/filesystem-backed) ---
ARTIFACT_ENDPOINT=localhost:9000
ARTIFACT_ACCESS_KEY=oce-local-access
ARTIFACT_SECRET_KEY=change-me-local-only

# --- Local secrets (documented secure injection) ---
# Locally, load secrets from the OS credential store or an injected env var.
# Local development secrets must never equal future cloud/production secrets.

# --- Cloud activation (deferred). Leave unset. Leader does not require them ---
# CLOUD_AUTHORIZATION_ENVELOPE=
# CLOUD_PROVIDER=
# CLOUD_PROVIDER_API_TOKEN=