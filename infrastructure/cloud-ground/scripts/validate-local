#!/usr/bin/env bash
#
# OCE Cloud Ground — Local Validation Entrypoint
# B1-I1R3F — Thin wrapper around shared runner
#
# This script is a thin wrapper. It generates a local OCE_RUN_ID and
# delegates to the shared runner. It does NOT duplicate any validation logic.
#
# Usage:
#   ./infrastructure/cloud-ground/scripts/validate-local
#
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHARED_RUNNER="$SCRIPT_DIR/run-validation.sh"

if [ ! -f "$SHARED_RUNNER" ]; then
    echo "FATAL: Shared runner not found at $SHARED_RUNNER" >&2
    exit 1
fi

if [ ! -x "$SHARED_RUNNER" ]; then
    chmod +x "$SHARED_RUNNER"
fi

# Generate local OCE_RUN_ID (caller must provide this)
if [ -z "${OCE_RUN_ID:-}" ]; then
    export OCE_RUN_ID=$(python3 -c "import secrets; print(secrets.token_hex(6))")
fi

# Set local mode
export OCE_CI_MODE="false"

echo "════════════════════════════════════════════════════════════════"
echo "  OCE B1-I1R3F Local Validation (thin wrapper)"
echo "  OCE_RUN_ID: $OCE_RUN_ID"
echo "════════════════════════════════════════════════════════════════"
echo ""

# Delegate entirely to the shared runner
exec bash "$SHARED_RUNNER"
