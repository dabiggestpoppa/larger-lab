# OCE Cloud Ground — Environment Configuration Example
# B1-I1 — ALL VALUES ARE PLACEHOLDERS
# Copy to .env and replace with actual values
# NEVER commit .env files with real credentials

# PostgreSQL Configuration
POSTGRES_DB=oce
POSTGRES_USER=oce_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Redis Configuration (no auth by default — internal only)
# REDIS_PASSWORD=CHANGE_ME_IF_NEEDED

# Backup Configuration
OCE_BACKUP_TARGET=s3:s3.amazonaws.com/CHANGE_ME_BUCKET
OCE_BACKUP_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
OCE_BACKUP_SECRET_KEY=CHANGE_ME_SECRET_KEY
OCE_BACKUP_PASSWORD=CHANGE_ME_BACKUP_PASSWORD

# Tailscale
OCE_TAILSCALE_AUTH_KEY=tskey-auth-CHANGE_ME

# Monitoring
OCE_ALERT_DISK_WARNING=70
OCE_ALERT_DISK_CRITICAL=85
OCE_ALERT_MEMORY_WARNING=75
OCE_ALERT_MEMORY_CRITICAL=90

# Provider (for reference — NOT used in compose)
OCE_PROVIDER=netcup
OCE_PLAN=rs-4000-g12
OCE_REGION=EU
