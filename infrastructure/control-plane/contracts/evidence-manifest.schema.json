{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dabiggestpoppa/larger-lab/schema/control-plane/evidence-manifest.json",
  "title": "OCE Control Plane Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "run_id", "produced_at", "artifacts", "outer_digest"],
  "properties": {
    "manifest_id": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{12,}$" },
    "produced_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "sha256", "size_bytes"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "required": { "type": "boolean" }
        }
      },
      "minItems": 1
    },
    "outer_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
