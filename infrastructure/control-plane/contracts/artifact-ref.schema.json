{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dabiggestpoppa/larger-lab/schema/control-plane/artifact-ref.json",
  "title": "OCE Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "producer", "environment", "source_hash", "input_hashes", "created_at", "status"],
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
    "artifact_type": { "type": "string", "minLength": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["local", "local-test", "local-recovery", "cloud-plan", "cloud"] },
    "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_hashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "minItems": 1 },
    "manifest_uri": { "type": "string" },
    "retention_policy": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["provisional", "verified", "promoted", "superseded", "quarantined"] },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
