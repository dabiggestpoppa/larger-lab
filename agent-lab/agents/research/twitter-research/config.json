{
  "agent_name": "twitter-bookmarks",
  "version": "2.0.0",
  "description": "Twitter/X bookmarks reader and organizer — no API needed",
  "platform": "hermes-skill",
  "environment": {},
  "permissions": {
    "browser": "read — access twitter.com/i/bookmarks",
    "filesystem": "write — workspace/twitter-bookmarks/ and shared/"
  },
  "defaults": {
    "bookmarks_url": "https://twitter.com/i/bookmarks",
    "workspace_dir": "workspace/twitter-bookmarks",
    "topics": ["AI", "trading", "tools", "research", "news"],
    "overlap_channel": "shared/overlap-log.jsonl"
  },
  "commands": {
    "/bookmarks": "Read and organize all Twitter bookmarks",
    "/bookmarks --topic <topic>": "Filter bookmarks by topic",
    "/bookmarks --summarize": "Process bookmarks and produce summary report",
    "/bookmarks --links": "Extract all links organized by domain",
    "/bookmarks --since <date>": "Only process bookmarks after date",
    "/bookmarks add <url>": "Manually add a URL to collection"
  },
  "schedule": {
    "cron": "manual",
    "description": "Run on-demand when user requests bookmark processing"
  },
  "output": {
    "index": "workspace/twitter-bookmarks/index.md",
    "by_topic": "workspace/twitter-bookmarks/by-topic/",
    "by_date": "workspace/twitter-bookmarks/by-date/",
    "links": "workspace/twitter-bookmarks/links.md",
    "overlap_channel": "shared/overlap-log.jsonl"
  },
  "oph_alignment": {
    "observer_patch": "twitter-bookmarks",
    "overlap_protocol": "append-to-shared-jsonl",
    "consensus_role": "partial-observer — provides user-curated signal data"
  }
}